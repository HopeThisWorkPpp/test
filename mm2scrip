end

local function EquipGun()
    local gun = LocalPlayer.Backpack:FindFirstChild("Gun")
    if gun then
        LocalPlayer.Character.Humanoid:EquipTool(gun)
        return gun
    end
    return LocalPlayer.Character:FindFirstChild("Gun")
end

local function EquipKnife()
    local knife = LocalPlayer.Backpack:FindFirstChild("Knife")
    if knife then
        LocalPlayer.Character.Humanoid:EquipTool(knife)
        return knife
    end
    return LocalPlayer.Character:FindFirstChild("Knife")
end

-- Which weapon you're holding tells you your role. MM2 doesn't hand you a
-- "Role" value directly — the tool in your Backpack/Character IS the role.
local function GetMyRole()
    if not LocalPlayer.Character then return "Unknown" end
    if LocalPlayer.Character:FindFirstChild("Knife") or LocalPlayer.Backpack:FindFirstChild("Knife") then
        return "Murderer"
    end
    if LocalPlayer.Character:FindFirstChild("Gun") or LocalPlayer.Backpack:FindFirstChild("Gun") then
        return "Sheriff"
    end
    return "Innocent"
end

-- As murderer there's no single fixed target like the sheriff has (the
-- murderer) — anyone else is fair game, so just go for whoever's closest.
local function GetNearestPlayer()
    local myHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myHRP then return nil end

    local nearest, nearestDist = nil, math.huge
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local hrp = player.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                local dist = (hrp.Position - myHRP.Position).Magnitude
                if dist < nearestDist then
                    nearest = player
                    nearestDist = dist
                end
            end
        end
    end
    return nearest
end

-- Smoothed velocity buffer (reduces jitter from jump-spam / touch input lag on mobile)
local smoothedTargetVelocity = Vector3.new(0, 0, 0)

-- Shared prediction math for both gun shots and knife throws. Horizontal is
-- linear (roughly constant velocity over the prediction window). Vertical
-- only gets the gravity/kinematic correction while the target is actually
-- airborne — applying it while grounded was dragging shots into the floor.
local function PredictTargetPosition(targetHRP, targetHumanoid)
    local rawVelocity = targetHRP.AssemblyLinearVelocity
    smoothedTargetVelocity = smoothedTargetVelocity:Lerp(rawVelocity, 0.6)

    local predictedX = targetHRP.Position.X + (smoothedTargetVelocity.X * prediction)
    local predictedZ = targetHRP.Position.Z + (smoothedTargetVelocity.Z * prediction)

    local gravity = workspace.Gravity
    local state = targetHumanoid and targetHumanoid:GetState()
    local isAirborne = state == Enum.HumanoidStateType.Jumping
        or state == Enum.HumanoidStateType.Freefall

    local predictedY
    if isAirborne then
        predictedY = targetHRP.Position.Y
            + (smoothedTargetVelocity.Y * prediction)
            - (0.5 * gravity * prediction ^ 2)
    else
        predictedY = targetHRP.Position.Y
    end

    return Vector3.new(predictedX, predictedY, predictedZ) + Vector3.new(0, verticalOffset, 0)
end

local function ShootMurderer()
    local murderer = GetMurderer()
    if not murderer or not murderer.Character then return end

    local targetHRP = murderer.Character:FindFirstChild("HumanoidRootPart")
    local myHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")

    if not targetHRP or not myHRP then return end

    local gun = EquipGun()
    if not gun then return end

    local shootRemote = gun:FindFirstChild("Shoot")
    if not shootRemote then return end

    local targetHumanoid = murderer.Character:FindFirstChild("Humanoid")
    local predicted = PredictTargetPosition(targetHRP, targetHumanoid)

    local args = {
        CFrame.new(myHRP.Position, predicted),
        CFrame.new(predicted)
    }
    shootRemote:FireServer(unpack(args))
end

local function ThrowKnife()
    local target = GetNearestPlayer()
    if not target or not target.Character then return end

    local targetHRP = target.Character:FindFirstChild("HumanoidRootPart")
    local myHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not targetHRP or not myHRP then return end

    local knife = EquipKnife()
    if not knife then return end

    -- NOTE: "Shoot" was confirmed correct for the gun by testing in-game.
    -- The knife's throw remote may have a different name — check the
    -- Knife tool's children in Explorer while holding it and adjust the
    -- FindFirstChild list below if this doesn't fire anything.
    local throwRemote = knife:FindFirstChild("Throw")
        or knife:FindFirstChild("ThrowKnife")
        or knife:FindFirstChild("Remote")
    if not throwRemote then
        warn("⚠️ Knife throw remote not found — check Knife's children in Explorer and update ThrowKnife()")
        return
    end

    local targetHumanoid = target.Character:FindFirstChild("Humanoid")
    local predicted = PredictTargetPosition(targetHRP, targetHumanoid)

    local args = {
        CFrame.new(myHRP.Position, predicted),
        CFrame.new(predicted)
    }
    throwRemote:FireServer(unpack(args))
end

-- Single entry point the UI calls — picks shoot vs throw based on which
-- weapon you're actually holding, so every button/keybind stays the same.
local function PerformAttack()
    local role = GetMyRole()
    if role == "Sheriff" then
        ShootMurderer()
    elseif role == "Murderer" then
        ThrowKnife()
    end
end

-- ===== AUTO-SHOOT =====
local function AutoShootLoop()
    if not autoShoot then return end

    local role = GetMyRole()
    local target, targetHRP

    if role == "Sheriff" then
        target = GetMurderer()
    elseif role == "Murderer" then
        target = GetNearestPlayer()
    else
        return
    end

    if not target or not target.Character then return end
    targetHRP = target.Character:FindFirstChild("HumanoidRootPart")
    if not targetHRP then return end

    local screenPos, onScreen = Camera:WorldToViewportPoint(targetHRP.Position)
    if onScreen then
        local distance = (Vector2.new(screenPos.X, screenPos.Y) - Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)).Magnitude
        if distance < fovRadius then
            PerformAttack()
            task.wait(math.random(150, 350) / 1000)
        end
    end
end

-- ===== MOBILE GUI =====
local function CreateMobileGUI()
    if mobileGUI then mobileGUI:Destroy() end
    
    mobileGUI = Instance.new("ScreenGui")
    mobileGUI.Name = "MM2MobileGUI"
    mobileGUI.ResetOnSpawn = false
    mobileGUI.IgnoreGuiInset = true
    mobileGUI.Parent = LocalPlayer.PlayerGui
    
    buttonFrame = Instance.new("Frame")
    buttonFrame.Size = UDim2.new(0, 120, 0, 120)
    buttonFrame.Position = UDim2.new(0.85, -60, 0.75, -60)
    buttonFrame.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
    buttonFrame.BackgroundTransparency = 0.3
    buttonFrame.BorderSizePixel = 2
    buttonFrame.BorderColor3 = Color3.fromRGB(255, 255, 255)
    buttonFrame.Parent = mobileGUI
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(1, 0)
    corner.Parent = buttonFrame
    
    local buttonLabel = Instance.new("TextLabel")
    buttonLabel.Size = UDim2.new(1, 0, 1, 0)
    buttonLabel.BackgroundTransparency = 1
    buttonLabel.Text = "🔫"
    buttonLabel.TextSize = 50
    buttonLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    buttonLabel.Font = Enum.Font.SourceSansBold
    buttonLabel.Parent = buttonFrame
    
    local button = Instance.new("ImageButton")
    button.Size = UDim2.new(1, 0, 1, 0)
    button.BackgroundTransparency = 1
    button.Parent = buttonFrame
    
    button.MouseButton1Click:Connect(function()
        if autoShoot then
            print("Auto-shoot is on! Toggle off for manual.")
        else
            PerformAttack()
        end
    end)
    
    local dragging = false
    local dragStart, startPos
    
    button.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = buttonFrame.Position
        end
    end)
    
    button.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    
    button.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.Touch then
            local delta = input.Position - dragStart
            local viewportSize = game:GetService("GuiService"):GetScreenResolution()
            buttonFrame.Position = UDim2.new(
                startPos.X.Scale + (delta.X / viewportSize.X),
                0,
                startPos.Y.Scale + (delta.Y / viewportSize.Y),
                0
            )
        end
    end)
end

