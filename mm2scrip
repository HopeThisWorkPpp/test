-- ===== AIM FUNCTIONS =====
local function GetMurderer()
    for _, v in pairs(Players:GetPlayers()) do
        if v ~= LocalPlayer then
            if v.Backpack:FindFirstChild("Knife") or (v.Character and v.Character:FindFirstChild("Knife")) then
                return v
            end
        end
    end
    return nil
end

local function EquipGun()
    local gun = LocalPlayer.Backpack:FindFirstChild("Gun")
    if gun then
        LocalPlayer.Character.Humanoid:EquipTool(gun)
        return gun
    end
    return LocalPlayer.Character:FindFirstChild("Gun")
end

local function EquipKnife()
    local knife = LocalPlayer.Backpack:FindFirstChild("Knife")
    if knife then
        LocalPlayer.Character.Humanoid:EquipTool(knife)
        return knife
    end
    return LocalPlayer.Character:FindFirstChild("Knife")
end

-- Which weapon you're holding tells you your role. MM2 doesn't hand you a
-- "Role" value directly — the tool in your Backpack/Character IS the role.
local function GetMyRole()
    if not LocalPlayer.Character then return "Unknown" end
    if LocalPlayer.Character:FindFirstChild("Knife") or LocalPlayer.Backpack:FindFirstChild("Knife") then
        return "Murderer"
    end
    if LocalPlayer.Character:FindFirstChild("Gun") or LocalPlayer.Backpack:FindFirstChild("Gun") then
        return "Sheriff"
    end
    return "Innocent"
end

-- As murderer there's no single fixed target like the sheriff has (the
-- murderer) — anyone else is fair game, so just go for whoever's closest.
local function GetNearestPlayer()
    local myHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myHRP then return nil end

    local nearest, nearestDist = nil, math.huge
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local hrp = player.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                local dist = (hrp.Position - myHRP.Position).Magnitude
                if dist < nearestDist then
                    nearest = player
                    nearestDist = dist
                end
            end
        end
    end
    return nearest
end

-- Smoothed velocity buffer (reduces jitter from jump-spam / touch input lag on mobile)
local smoothedTargetVelocity = Vector3.new(0, 0, 0)

-- Live ping in seconds (round trip). Mobile connections fluctuate a lot, so
-- a fixed prediction time undershoots when latency spikes and overshoots
-- when it's low. This gets added on top of the base "Prediction Time"
-- slider to compensate for whatever your connection is doing right now.
local function GetPingSeconds()
    local ok, ms = pcall(function()
        return StatsService.Network.ServerStatsItem["Data Ping"]:GetValue()
    end)
    if ok and ms then
        return ms / 1000
    end
    return 0
end

-- Shared prediction math for both gun shots and knife throws. Horizontal is
-- linear (roughly constant velocity over the prediction window). Vertical
-- only gets the gravity/kinematic correction while the target is actually
-- airborne — applying it while grounded was dragging shots into the floor.
local function PredictTargetPosition(targetHRP, targetHumanoid)
    local rawVelocity = targetHRP.AssemblyLinearVelocity
    smoothedTargetVelocity = smoothedTargetVelocity:Lerp(rawVelocity, 0.6)

    -- Only compensate for how far CURRENT ping deviates from a typical
    -- baseline (~100ms one-way) — that baseline is already baked into your
    -- tuned 0.185s default, so this only kicks in during lag spikes/dips
    -- instead of shifting normal-condition shots that were already working.
    local assumedBaselinePing = 0.1
    local currentOneWayPing = GetPingSeconds() * 0.5
    local pingCompensation = math.clamp(currentOneWayPing - assumedBaselinePing, -0.05, 0.15)
    local effectivePrediction = prediction + pingCompensation

    local predictedX = targetHRP.Position.X + (smoothedTargetVelocity.X * effectivePrediction)
    local predictedZ = targetHRP.Position.Z + (smoothedTargetVelocity.Z * effectivePrediction)

    local gravity = workspace.Gravity
    local state = targetHumanoid and targetHumanoid:GetState()
    local isAirborne = state == Enum.HumanoidStateType.Jumping
        or state == Enum.HumanoidStateType.Freefall

    local predictedY
    if isAirborne then
        predictedY = targetHRP.Position.Y
            + (smoothedTargetVelocity.Y * effectivePrediction)
            - (0.5 * gravity * effectivePrediction ^ 2)
    else
        predictedY = targetHRP.Position.Y
    end

    return Vector3.new(predictedX, predictedY, predictedZ) + Vector3.new(0, verticalOffset, 0)
end

local function ShootMurderer()
    local murderer = GetMurderer()
    if not murderer or not murderer.Character then return end

    local targetHRP = murderer.Character:FindFirstChild("HumanoidRootPart")
    local myHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")

    if not targetHRP or not myHRP then return end

    local gun = EquipGun()
    if not gun then return end

    local shootRemote = gun:FindFirstChild("Shoot")
    if not shootRemote then return end

    local targetHumanoid = murderer.Character:FindFirstChild("Humanoid")
    local predicted = PredictTargetPosition(targetHRP, targetHumanoid)

    local args = {
        CFrame.new(myHRP.Position, predicted),
        CFrame.new(predicted)
    }
    shootRemote:FireServer(unpack(args))
end

-- ===== DEBUG: FIND KNIFE THROW REMOTE =====
-- The gun's remote ("Shoot") lives directly on the Gun tool, but MM2's
-- knife throw very often routes through a shared remote in
-- ReplicatedStorage instead. This dumps candidates to the console so we
-- can point ThrowKnife() at the right one without guessing blind.
local function DebugKnife()
    local knife = EquipKnife()
    if not knife then
        warn("⚠️ No Knife found in Backpack or Character")
        return
    end

    print("=== Knife tool children (ClassName: Name) ===")
    for _, child in pairs(knife:GetChildren()) do
        print(child.ClassName .. ": " .. child.Name)
    end

    -- Check inside any subfolder (e.g. "Events") since MM2 tools often
    -- organize their remotes there instead of leaving them loose on the tool.
    local eventsFolder = knife:FindFirstChild("Events")
    if eventsFolder then
        print("=== Contents of Knife.Events ===")
        for _, child in pairs(eventsFolder:GetChildren()) do
            print(child.ClassName .. ": " .. child.Name)
        end
    end

    print("=== ReplicatedStorage remotes matching 'knife' or 'throw' ===")
    local found = false
    for _, obj in pairs(ReplicatedStorage:GetDescendants()) do
        if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
            local lname = obj.Name:lower()
            if lname:find("knife") or lname:find("throw") then
                print(obj.ClassName .. ": " .. obj:GetFullName())
                found = true
            end
        end
    end
    if not found then
        print("(none found — the remote may be nested in a folder with a generic name, or fired via a different service)")
    end
end

local function ThrowKnife()
    local target = GetNearestPlayer()
    if not target or not target.Character then return end

    local targetHRP = target.Character:FindFirstChild("HumanoidRootPart")
    local myHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not targetHRP or not myHRP then return end

    local knife = EquipKnife()
    if not knife then return end

    -- Confirmed via in-game Explorer dump: lives at Knife.Events.KnifeThrown
    -- (siblings KnifeStabbed and HandleTouched are for the melee stab, not
    -- the throw — don't use those here).
    local eventsFolder = knife:FindFirstChild("Events")
    local throwRemote = eventsFolder and eventsFolder:FindFirstChild("KnifeThrown")
    if not throwRemote then
        warn("⚠️ Knife.Events.KnifeThrown not found — knife structure may have changed, rerun Debug Knife Remote")
        return
    end

    -- Argument signature is unverified — using the same pattern that worked
    -- for the gun's "Shoot" remote (origin CFrame, target CFrame) as a
    -- starting guess. If nothing happens or you get a Roblox Console error
    -- when this fires, check the error/warning text and tell me — it'll
    -- usually say exactly what type/count of args KnifeThrown expects.
    local targetHumanoid = target.Character:FindFirstChild("Humanoid")
    local predicted = PredictTargetPosition(targetHRP, targetHumanoid)

    local args = {
        CFrame.new(myHRP.Position, predicted),
        CFrame.new(predicted)
    }
    throwRemote:FireServer(unpack(args))
end

-- Single entry point the UI calls — picks shoot vs throw based on which
-- weapon you're actually holding, so every button/keybind stays the same.
local function PerformAttack()
    local role = GetMyRole()
    if role == "Sheriff" then
        ShootMurderer()
    elseif role == "Murderer" then
        ThrowKnife()
    end
end

-- ===== AUTO-SHOOT =====
local function AutoShootLoop()
    if not autoShoot then return end

    local role = GetMyRole()
    local target, targetHRP

    if role == "Sheriff" then
        target = GetMurderer()
    elseif role == "Murderer" then
        target = GetNearestPlayer()
    else
        return
    end

    if not target or not target.Character then return end
    targetHRP = target.Character:FindFirstChild("HumanoidRootPart")
    if not targetHRP then return end

    local screenPos, onScreen = Camera:WorldToViewportPoint(targetHRP.Position)
    if onScreen then
        local distance = (Vector2.new(screenPos.X, screenPos.Y) - Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)).Magnitude
        if distance < fovRadius then
            PerformAttack()
            task.wait(math.random(150, 350) / 1000)
        end
    end
end

