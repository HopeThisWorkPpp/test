-- ===== FUNCTIONS =====

local function GetPlayerRole(player)
    if not player or not player.Character then return "Unknown" end
    
    if player.Backpack:FindFirstChild("Knife") or (player.Character and player.Character:FindFirstChild("Knife")) then
        return "Murderer"
    end
    
    if player.Backpack:FindFirstChild("Gun") or (player.Character and player.Character:FindFirstChild("Gun")) then
        return "Sheriff"
    end
    
    local hasWeapon = false
    for _, tool in pairs(player.Backpack:GetChildren()) do
        if tool:IsA("Tool") then
            hasWeapon = true
            break
        end
    end
    if not hasWeapon then
        for _, tool in pairs(player.Character:GetChildren()) do
            if tool:IsA("Tool") then
                hasWeapon = true
                break
            end
        end
    end
    
    return hasWeapon and "Unknown" or "Innocent"
end

local function GetRoleColor(role)
    if role == "Murderer" then return Color3.fromRGB(255, 0, 0)
    elseif role == "Sheriff" then return Color3.fromRGB(0, 150, 255)
    elseif role == "Innocent" then return Color3.fromRGB(0, 255, 0)
    else return Color3.fromRGB(255, 255, 255) end
end

-- ===== GLOW ESP FUNCTIONS =====
local function CreateGlowESP(player)
    if not player or player == LocalPlayer or not player.Character then return end
    
    local character = player.Character
    local role = GetPlayerRole(player)
    local color = GetRoleColor(role)
    
    local highlight = Instance.new("Highlight")
    highlight.Name = "GlowESP_" .. player.Name
    highlight.Adornee = character
    highlight.FillColor = color
    highlight.FillTransparency = 0.5
    highlight.OutlineColor = color
    highlight.OutlineTransparency = 0.1
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = character
    
    table.insert(espObjects, {
        Player = player,
        Highlight = highlight,
        Color = color
    })
end

local function UpdateGlowESP()
    if not espEnabled then return end
    
    for _, esp in pairs(espObjects) do
        local player = esp.Player
        if not player or not player.Character then
            if esp.Highlight then esp.Highlight:Destroy() end
            continue
        end
        
        local role = GetPlayerRole(player)
        local color = GetRoleColor(role)
        
        if esp.Highlight then
            esp.Highlight.FillColor = color
            esp.Highlight.OutlineColor = color
            esp.Color = color
        end
    end
end

local function RemoveGlowESP(player)
    for i, esp in pairs(espObjects) do
        if esp.Player == player then
            if esp.Highlight then esp.Highlight:Destroy() end
            table.remove(espObjects, i)
            break
        end
    end
end

-- ===== GUN ESP FUNCTIONS (COMPLETELY REWRITTEN) =====
local RemoveGunESP -- forward declared: CreateGunESP calls this before it's defined below

-- Tools don't have a .Position property — only their Handle (or any BasePart
-- inside them) does. Reading tool.Position directly throws every frame,
-- which was silently killing the ESP coroutine before anything ever drew.
local function GetToolPosition(tool)
    if not tool then return nil end
    local handle = tool:FindFirstChild("Handle")
    if handle and handle:IsA("BasePart") then
        return handle.Position
    end
    -- Fallback: any BasePart directly inside the tool
    for _, child in pairs(tool:GetChildren()) do
        if child:IsA("BasePart") then
            return child.Position
        end
    end
    return nil
end

local function CreateGunESP(tool)
    if not tool then return end
    if tool.Name ~= "Gun" then return end
    
    -- Check if gun already has ESP
    for _, esp in pairs(gunESPObjects) do
        if esp.Tool == tool then
            return
        end
    end
    
    -- Check if gun is held by ANY player
    local isHeld = false
    
    -- Check ALL players
    for _, player in pairs(Players:GetPlayers()) do
        if player.Character then
            -- Check if gun is in character
            if player.Character:FindFirstChild("Gun") == tool then
                isHeld = true
                break
            end
            -- Check if gun is in a tool in character
            for _, child in pairs(player.Character:GetChildren()) do
                if child:IsA("Tool") and child == tool then
                    isHeld = true
                    break
                end
            end
        end
        if player.Backpack then
            if player.Backpack:FindFirstChild("Gun") == tool then
                isHeld = true
                break
            end
        end
    end
    
    -- If held, remove ESP if it exists
    if isHeld then
        RemoveGunESP(tool)
        return
    end
    
    -- Check if tool is in a character model directly
    if tool.Parent then
        if tool.Parent:IsA("Model") and tool.Parent:FindFirstChild("Humanoid") then
            isHeld = true
        end
        if tool.Parent:IsA("Backpack") then
            isHeld = true
        end
    end
    
    -- Only create ESP if NOT held
    if not isHeld then
        -- Create a part to attach the billboard to (since tools can be tiny)
        local espPart = Instance.new("Part")
        espPart.Name = "GunESP_Part"
        espPart.Size = Vector3.new(1, 1, 1)
        espPart.Transparency = 1
        espPart.CanCollide = false
        espPart.Anchored = true
        espPart.Parent = tool
        espPart.Position = GetToolPosition(tool) or espPart.Position
        
        -- Keep the part at the tool's position
        spawn(function()
            while espPart and espPart.Parent and tool and tool.Parent do
                local pos = GetToolPosition(tool)
                if pos then
                    espPart.Position = pos
                end
                task.wait(0.1)
            end
        end)
        
        local billboard = Instance.new("BillboardGui")
        billboard.Name = "GunESP"
        billboard.Size = UDim2.new(0, 180, 0, 60)
        billboard.Adornee = espPart
        billboard.AlwaysOnTop = true
        billboard.StudsOffset = Vector3.new(0, 2.5, 0)
        billboard.MaxDistance = 200
        billboard.Parent = espPart
        
        -- Main frame
        local frame = Instance.new("Frame")
        frame.Size = UDim2.new(1, 0, 1, 0)
        frame.BackgroundColor3 = Color3.fromRGB(255, 200, 0)
        frame.BackgroundTransparency = 0.1
        frame.BorderSizePixel = 3
        frame.BorderColor3 = Color3.fromRGB(255, 255, 255)
        frame.Parent = billboard
        
        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 10)
        corner.Parent = frame
        
        -- Gun icon + text
        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1, 0, 1, 0)
        label.BackgroundTransparency = 1
        label.Text = "🔫 GUN DROPPED!"
        label.TextSize = 20
        label.TextColor3 = Color3.fromRGB(255, 255, 255)
        label.Font = Enum.Font.SourceSansBold
        label.TextStrokeTransparency = 0.1
        label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        label.Parent = frame
        
        -- Distance label
        local distanceLabel = Instance.new("TextLabel")
        distanceLabel.Size = UDim2.new(1, 0, 0, 20)
        distanceLabel.Position = UDim2.new(0, 0, 1.3, 0)
        distanceLabel.BackgroundTransparency = 1
        distanceLabel.Text = "0 studs"
        distanceLabel.TextSize = 14
        distanceLabel.TextColor3 = Color3.fromRGB(255, 255, 200)
        distanceLabel.Font = Enum.Font.SourceSans
        distanceLabel.TextStrokeTransparency = 0.3
        distanceLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        distanceLabel.Parent = billboard
        
        -- Arrow
        local arrow = Instance.new("TextLabel")
        arrow.Size = UDim2.new(0, 30, 0, 30)
        arrow.Position = UDim2.new(0.5, -15, -1.5, 0)
        arrow.BackgroundTransparency = 1
        arrow.Text = "⬇️"
        arrow.TextSize = 30
        arrow.TextColor3 = Color3.fromRGB(255, 200, 0)
        arrow.Font = Enum.Font.SourceSansBold
        arrow.Parent = billboard
        
        table.insert(gunESPObjects, {
            Tool = tool,
            ESPPart = espPart,
            Billboard = billboard,
            Frame = frame,
            Label = label,
            DistanceLabel = distanceLabel,
            Arrow = arrow
        })
        
        -- Animate
        spawn(function()
            local startTime = tick()
            while billboard and billboard.Parent do
                local elapsed = tick() - startTime
                local pulse = 0.5 + 0.5 * math.sin(elapsed * 2)
                
                if frame then
                    frame.BackgroundTransparency = 0.1 + (0.2 * pulse)
                    frame.BorderColor3 = Color3.fromRGB(255, 200 + (55 * pulse), 0)
                end
                
                if arrow then
                    arrow.Position = UDim2.new(0.5, -15, -1.5 - (0.2 * pulse), 0)
                end
                
                if distanceLabel and LocalPlayer.Character then
                    local myPos = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                    local toolPos = GetToolPosition(tool)
                    if myPos and toolPos then
                        local distance = (myPos.Position - toolPos).Magnitude
                        distanceLabel.Text = math.floor(distance) .. " studs"
                    end
                end
                
                task.wait(0.05)
            end
        end)
        
        print("🔫 Gun ESP created for dropped gun!")
    end
end

