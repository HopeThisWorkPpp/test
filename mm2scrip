    if knife then
        LocalPlayer.Character.Humanoid:EquipTool(knife)
        return knife
    end
    return LocalPlayer.Character:FindFirstChild("Knife")
end

local function GetMyRole()
    if not LocalPlayer.Character then return "Unknown" end
    if LocalPlayer.Character:FindFirstChild("Knife") or LocalPlayer.Backpack:FindFirstChild("Knife") then
        return "Murderer"
    end
    if LocalPlayer.Character:FindFirstChild("Gun") or LocalPlayer.Backpack:FindFirstChild("Gun") then
        return "Sheriff"
    end
    return "Innocent"
end

-- ===== PREDICTION (per-target velocity buffers + iterative) =====
local velocityBuffers = {}  -- [HumanoidRootPart] = Vector3

local function GetSmoothedVelocity(hrp)
    local raw = hrp.AssemblyLinearVelocity
    local buf = velocityBuffers[hrp]
    if buf == nil then
        velocityBuffers[hrp] = raw
        return raw
    end
    local smoothed = buf:Lerp(raw, velocitySmoothing)
    velocityBuffers[hrp] = smoothed
    return smoothed
end

local AIRBORNE_STATES = {
    [Enum.HumanoidStateType.Jumping] = true,
    [Enum.HumanoidStateType.Freefall] = true,
    [Enum.HumanoidStateType.Physics] = true,
    [Enum.HumanoidStateType.FallingDown] = true,
}

local function IsAirborne(humanoid)
    if not humanoid then return false end
    local ok, state = pcall(function() return humanoid:GetState() end)
    return ok and AIRBORNE_STATES[state] == true
end

local function PredictOne(hrp, humanoid, t, vel)
    local px = hrp.Position.X + vel.X * t
    local pz = hrp.Position.Z + vel.Z * t
    local py
    if IsAirborne(humanoid) then
        py = hrp.Position.Y + vel.Y * t - 0.5 * Workspace.Gravity * t * t
    else
        py = hrp.Position.Y
    end
    return Vector3.new(px, py, pz) + Vector3.new(0, verticalOffset, 0)
end

-- Iterative solve: predict using travel time, re-read velocity, converge.
local function PredictPosition(targetHRP, targetHumanoid, speed, reactionTime)
    local t = reactionTime or gunReactionTime
    local predicted
    for _ = 1, predictionIterations do
        local vel = GetSmoothedVelocity(targetHRP)
        local distance = predicted and (predicted - targetHRP.Position).Magnitude or 0
        -- First pass uses raw distance; subsequent passes use predicted travel
        local myHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        local realDistance = myHRP and (targetHRP.Position - myHRP.Position).Magnitude or 0
        local useDistance = (predicted == nil) and realDistance or realDistance
        local travel = useDistance / speed + t
        predicted = PredictOne(targetHRP, targetHumanoid, travel, vel)
    end
    return predicted
end

-- Prefer attachment origin, then head, then root
local function GetAimOrigin()
    local char = LocalPlayer.Character
    if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local head = char:FindFirstChild("Head")
    local gun = char:FindFirstChild("Gun")
    if gun then
        local att = gun:FindFirstChild("GunRaycastAttachment")
        if att and att:IsA("Attachment") then
            local ok, cf = pcall(function() return att.WorldCFrame end)
            if ok and cf then return cf.Position end
        end
    end
    if head then return head.Position end
    return hrp and hrp.Position or nil
end

local function ShootMurderer()
    local murderer = GetMurderer()
    if not murderer or not murderer.Character then return false end
    local targetHRP = murderer.Character:FindFirstChild("HumanoidRootPart")
    if not targetHRP then return false end
    local myChar = LocalPlayer.Character
    if not myChar or not myChar:FindFirstChild("Gun") then
        EquipGun()
        task.wait(0.15)
        if not LocalPlayer.Character:FindFirstChild("Gun") then return false end
    end
    local gun = LocalPlayer.Character:FindFirstChild("Gun")
    if not gun then return false end
    local shootRemote = gun:FindFirstChild("Shoot")
    if not shootRemote then return false end
    if not HasLineOfSight(targetHRP) then
        print("⚠️ No line of sight to murderer — shot aborted")
        return false
    end
    local origin = GetAimOrigin()
    if not origin then return false end
    local targetHum = murderer.Character:FindFirstChildOfClass("Humanoid")
    local predicted = PredictPosition(targetHRP, targetHum, bulletSpeed, gunReactionTime)
    shootRemote:FireServer(
        CFrame.new(origin, predicted),
        CFrame.new(predicted)
    )
    return true
end

local function ThrowKnife()
    local target = GetNearestPlayer()
    if not target or not target.Character then return false end
    local targetHRP = target.Character:FindFirstChild("HumanoidRootPart")
    if not targetHRP then return false end
    if not LocalPlayer.Character:FindFirstChild("Knife") then
        EquipKnife()
        task.wait(0.15)
        if not LocalPlayer.Character:FindFirstChild("Knife") then return false end
    end
    local knife = LocalPlayer.Character:FindFirstChild("Knife")
    if not knife then return false end
    local events = knife:FindFirstChild("Events")
    local throwRemote = events and events:FindFirstChild("KnifeThrown")
    if not throwRemote then
        warn("⚠️ Knife.Events.KnifeThrown not found")
        return false
    end
    local origin = GetAimOrigin()
    if not origin then return false end
    local targetHum = target.Character:FindFirstChildOfClass("Humanoid")
    local predicted = PredictPosition(targetHRP, targetHum, knifeSpeed, 0)
    throwRemote:FireServer(
        CFrame.new(origin, predicted),
        CFrame.new(predicted)
    )
    return true
end

local function PerformAttack()
    local role = GetMyRole()
    if role == "Sheriff" then return ShootMurderer()
    elseif role == "Murderer" then return ThrowKnife() end
    return false
end

-- ===== AUTO-SHOOT (unchanged behavior, LOS-gated) =====
local function AutoShootLoop()
    if not autoShoot then return end
    local role = GetMyRole()
    local target
    if role == "Sheriff" then target = GetMurderer()
    elseif role == "Murderer" then target = GetNearestPlayer()
    else return end
    if not target or not target.Character then return end
    local targetHRP = target.Character:FindFirstChild("HumanoidRootPart")
    if not targetHRP then return end
    local screenPos, onScreen = Camera:WorldToViewportPoint(targetHRP.Position)
    if onScreen then
        local dist = (Vector2.new(screenPos.X, screenPos.Y) - Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)).Magnitude
        if dist < fovRadius and HasLineOfSight(targetHRP) then
            PerformAttack()
            task.wait(math.random(150, 350) / 1000)
        end
    end
end

-- ===== LOCK ON =====
local lockOnEnabled = false
local lockOnConnection = nil
local lockSmoothness = 0.25

local function GetEquippedWeaponRole()
    local c = LocalPlayer.Character
    if not c then return "Innocent" end
    if c:FindFirstChild("Knife") then return "Murderer" end
    if c:FindFirstChild("Gun") then return "Sheriff" end
    return "Innocent"
end

local function ToggleLockOn()
    lockOnEnabled = not lockOnEnabled
    if lockOnEnabled then
        lockOnConnection = RunService.RenderStepped:Connect(function()
            local role = GetEquippedWeaponRole()
            if role ~= "Sheriff" and role ~= "Murderer" then return end
            local target
            if role == "Sheriff" then target = GetMurderer()
            elseif role == "Murderer" then target = GetNearestPlayer() end
            if not target or not target.Character then return end
            local targetHRP = target.Character:FindFirstChild("HumanoidRootPart")
            if not targetHRP then return end
            local lookAt = targetHRP.Position + Vector3.new(0, verticalOffset, 0)
            local current = Camera.CFrame
            local desired = CFrame.new(current.Position, lookAt)
            Camera.CFrame = current:Lerp(desired, lockSmoothness)
        end)
        print("🔒 Lock On Enabled")
    else
        if lockOnConnection then lockOnConnection:Disconnect() end
        print("🔓 Lock On Disabled")
    end
end

