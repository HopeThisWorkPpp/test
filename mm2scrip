local function moveTo(target)
    if character and character:FindFirstChild("HumanoidRootPart") then
        humanoid:MoveTo(target)
    end
end

local function handleCommand(command)
    command = command:lower()
    
    if command:find("jump") and not command:find("don't") then
        humanoid.Jump = true
        StatusLabel.Text = "Jumped!"
    elseif command:find("crouch") then
        humanoid.Sit = true
        StatusLabel.Text = "Crouching"
    elseif command:find("sit down") or command:find("sit") then
        humanoid.Sit = true
        StatusLabel.Text = "Sitting"
    elseif command:find("stand up") or command:find("stand") then
        humanoid.Sit = false
        StatusLabel.Text = "Standing"
    elseif command:find("sprint") then
        humanoid.WalkSpeed = 30
        StatusLabel.Text = "Sprinting"
        task.wait(3)
        humanoid.WalkSpeed = 16
    elseif command:find("dance") then
        StatusLabel.Text = "Dancing"
    elseif command:find("don't move") or command:find("freeze") then
        humanoid.WalkSpeed = 0
        StatusLabel.Text = "Frozen!"
        task.wait(4)
        humanoid.WalkSpeed = 16
        StatusLabel.Text = "Unfrozen"
    elseif command:find("go to bed") or command:find("bed") then
        local bed = findNearestObject("Bed")
        if bed then
            moveTo(bed.Position)
            StatusLabel.Text = "Going to bed..."
        end
    elseif command:find("cafeteria") or command:find("lunch") then
        local caf = findNearestObject("Cafeteria")
        if caf then
            moveTo(caf.Position)
            StatusLabel.Text = "Going to cafeteria..."
        end
    elseif command:find("basement") then
        local base = findNearestObject("Basement")
        if base then
            moveTo(base.Position)
            StatusLabel.Text = "Going to basement..."
        end
    elseif command:find("second floor") or command:find("2nd floor") then
        local floor2 = findNearestObject("Stairs")
        if floor2 then
            moveTo(floor2.Position)
            StatusLabel.Text = "Going upstairs..."
        end
    elseif command:find("circle") or command:find("get in the circle") then
        local circle = findNearestObject("Circle")
        if circle then
            moveTo(circle.Position)
            StatusLabel.Text = "Moving to circle..."
        end
    elseif command:find("hide") then
        StatusLabel.Text = "Hiding..."
        -- Move to random far corner
        local rootPart = character:FindFirstChild("HumanoidRootPart")
        if rootPart then
            local randomPos = rootPart.Position + Vector3.new(math.random(-50, 50), 0, math.random(-50, 50))
            moveTo(randomPos)
        end
    elseif command:find("stand on the table") or command:find("stand on table") then
        local tableObj = findNearestObject("Table")
        if tableObj then
            moveTo(tableObj.Position + Vector3.new(0, 3, 0))
            StatusLabel.Text = "On table!"
        end
    elseif command:find("stand on the line") then
        local line = findNearestObject("Line")
        if line then
            moveTo(line.Position)
            StatusLabel.Text = "On the line!"
        end
    end
end

-- Chat detection
local function setupChatListener()
    for _, p in ipairs(Players:GetPlayers()) do
        p.Chatted:Connect(function(msg)
            if not ENABLED then return end
            if p.Name:lower():find("simon") then
                local lowerMsg = msg:lower()
                if lowerMsg:find("simon says") then
                    local command = lowerMsg:gsub("simon says", ""):gsub("^%s+", "")
                    handleCommand(command)
                end
            end
        end)
    end
    
    Players.PlayerAdded:Connect(function(p)
        p.Chatted:Connect(function(msg)
            if not ENABLED then return end
            if p.Name:lower():find("simon") then
                local lowerMsg = msg:lower()
                if lowerMsg:find("simon says") then
                    local command = lowerMsg:gsub("simon says", ""):gsub("^%s+", "")
                    handleCommand(command)
                end
            end
        end)
    end)
end

setupChatListener()

