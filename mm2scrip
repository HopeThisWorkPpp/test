-- ===== FUNCTIONS =====

local function GetPlayerRole(player)
    if not player or not player.Character then return "Unknown" end
    
    if player.Backpack:FindFirstChild("Knife") or (player.Character and player.Character:FindFirstChild("Knife")) then
        return "Murderer"
    end
    
    if player.Backpack:FindFirstChild("Gun") or (player.Character and player.Character:FindFirstChild("Gun")) then
        return "Sheriff"
    end
    
    local hasWeapon = false
    for _, tool in pairs(player.Backpack:GetChildren()) do
        if tool:IsA("Tool") then
            hasWeapon = true
            break
        end
    end
    if not hasWeapon then
        for _, tool in pairs(player.Character:GetChildren()) do
            if tool:IsA("Tool") then
                hasWeapon = true
                break
            end
        end
    end
    
    return hasWeapon and "Unknown" or "Innocent"
end

local function GetRoleColor(role)
    if role == "Murderer" then return Color3.fromRGB(255, 0, 0)
    elseif role == "Sheriff" then return Color3.fromRGB(0, 150, 255)
    elseif role == "Innocent" then return Color3.fromRGB(0, 255, 0)
    else return Color3.fromRGB(255, 255, 255) end
end

-- ===== GLOW ESP FUNCTIONS =====
local function CreateGlowESP(player)
    if not player or player == LocalPlayer or not player.Character then return end
    
    local character = player.Character
    local role = GetPlayerRole(player)
    local color = GetRoleColor(role)
    
    local highlight = Instance.new("Highlight")
    highlight.Name = "GlowESP_" .. player.Name
    highlight.Adornee = character
    highlight.FillColor = color
    highlight.FillTransparency = 0.5
    highlight.OutlineColor = color
    highlight.OutlineTransparency = 0.1
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = character
    
    table.insert(espObjects, {
        Player = player,
        Highlight = highlight,
        Color = color
    })
end

local function UpdateGlowESP()
    if not espEnabled then return end
    
    for _, esp in pairs(espObjects) do
        local player = esp.Player
        if not player or not player.Character then
            if esp.Highlight then esp.Highlight:Destroy() end
            continue
        end
        
        local role = GetPlayerRole(player)
        local color = GetRoleColor(role)
        
        if esp.Highlight then
            esp.Highlight.FillColor = color
            esp.Highlight.OutlineColor = color
            esp.Color = color
        end
    end
end

local function RemoveGlowESP(player)
    for i, esp in pairs(espObjects) do
        if esp.Player == player then
            if esp.Highlight then esp.Highlight:Destroy() end
            table.remove(espObjects, i)
            break
        end
    end
end

-- ===== GUN ESP FUNCTIONS (FIXED) =====
local function CreateGunESP(tool)
    if not tool then return end
    if tool.Name ~= "Gun" then return end
    
    -- Check if gun already has ESP
    for _, esp in pairs(gunESPObjects) do
        if esp.Tool == tool then
            return
        end
    end
    
    -- Check if gun is in a player's inventory (ignore)
    if tool.Parent and tool.Parent:IsA("Model") and tool.Parent:FindFirstChild("Humanoid") then
        return
    end
    if tool.Parent and tool.Parent:IsA("Backpack") then
        return
    end
    
    -- Check if the gun is actually on the ground (in workspace)
    if not tool.Parent or tool.Parent == Workspace then
        -- It's a dropped gun!
        local billboard = Instance.new("BillboardGui")
        billboard.Name = "GunESP"
        billboard.Size = UDim2.new(0, 120, 0, 40)
        billboard.Adornee = tool
        billboard.AlwaysOnTop = true
        billboard.StudsOffset = Vector3.new(0, 2, 0)
        billboard.MaxDistance = 150
        billboard.Parent = tool
        
        local frame = Instance.new("Frame")
        frame.Size = UDim2.new(1, 0, 1, 0)
        frame.BackgroundColor3 = Color3.fromRGB(255, 200, 0)
        frame.BackgroundTransparency = 0.2
        frame.BorderSizePixel = 2
        frame.BorderColor3 = Color3.fromRGB(255, 255, 255)
        frame.Parent = billboard
        
        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 8)
        corner.Parent = frame
        
        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1, 0, 1, 0)
        label.BackgroundTransparency = 1
        label.Text = "🔫 GUN DROPPED!"
        label.TextSize = 16
        label.TextColor3 = Color3.fromRGB(255, 255, 255)
        label.Font = Enum.Font.SourceSansBold
        label.TextStrokeTransparency = 0.2
        label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        label.Parent = frame
        
        -- Glow effect behind text
        local glowFrame = Instance.new("Frame")
        glowFrame.Size = UDim2.new(1.3, 0, 1.8, 0)
        glowFrame.Position = UDim2.new(-0.15, 0, -0.4, 0)
        glowFrame.BackgroundColor3 = Color3.fromRGB(255, 200, 0)
        glowFrame.BackgroundTransparency = 0.6
        glowFrame.BorderSizePixel = 0
        glowFrame.Parent = billboard
        
        local glowCorner = Instance.new("UICorner")
        glowCorner.CornerRadius = UDim.new(0, 12)
        glowCorner.Parent = glowFrame
        
        -- Arrow pointing to gun
        local arrow = Instance.new("TextLabel")
        arrow.Size = UDim2.new(0, 30, 0, 30)
        arrow.Position = UDim2.new(0.5, -15, -1.2, 0)
        arrow.BackgroundTransparency = 1
        arrow.Text = "⬇️"
        arrow.TextSize = 25
        arrow.TextColor3 = Color3.fromRGB(255, 200, 0)
        arrow.Font = Enum.Font.SourceSansBold
        arrow.Parent = billboard
        
        table.insert(gunESPObjects, {
            Tool = tool,
            Billboard = billboard,
            Frame = frame,
            GlowFrame = glowFrame,
            Label = label,
            Arrow = arrow
        })
        
        -- Animate the glow
        spawn(function()
            local startTime = tick()
            while billboard and billboard.Parent do
                local elapsed = tick() - startTime
                local pulse = 0.5 + 0.5 * math.sin(elapsed * 2.5)
                
                if glowFrame then
                    glowFrame.BackgroundTransparency = 0.4 + (0.4 * pulse)
                    glowFrame.Size = UDim2.new(1.1 + (0.3 * pulse), 0, 1.5 + (0.5 * pulse), 0)
                end
                
                if frame then
                    frame.BackgroundTransparency = 0.1 + (0.2 * pulse)
                    frame.BorderColor3 = Color3.fromRGB(255, 200 + (55 * pulse), 0)
                end
                
                if arrow then
                    arrow.Position = UDim2.new(0.5, -15, -1.2 - (0.1 * pulse), 0)
                end
                
                task.wait(0.05)
            end
        end)
        
        print("🔫 Gun ESP created for dropped gun!")
    end
end

local function RemoveGunESP(tool)
    for i, esp in pairs(gunESPObjects) do
        if esp.Tool == tool then
            if esp.Billboard then esp.Billboard:Destroy() end
            table.remove(gunESPObjects, i)
            break
        end
    end
end

-- SCAN FOR DROPPED GUNS (FIXED)
local function ScanForDroppedGuns()
    if not gunESPEnabled then return end
    
    -- Check ALL tools in workspace (dropped guns are directly in workspace)
    for _, tool in pairs(Workspace:GetChildren()) do
        if tool:IsA("Tool") and tool.Name == "Gun" then
            -- Check if tool is NOT in a character or backpack
            local isHeld = false
            
            -- Check if parent is a character model
            if tool.Parent and tool.Parent:IsA("Model") and tool.Parent:FindFirstChild("Humanoid") then
                isHeld = true
            end
            
            -- Check if parent is a backpack
            if tool.Parent and tool.Parent:IsA("Backpack") then
                isHeld = true
            end
            
            -- Check if tool is in a player's character through other means
            if tool.Parent and tool.Parent.Parent then
                local potentialCharacter = tool.Parent.Parent
                if potentialCharacter:IsA("Model") and potentialCharacter:FindFirstChild("Humanoid") then
                    isHeld = true
                end
            end
            
            -- If not held, it should be dropped on the ground
            if not isHeld then
                local hasESP = false
                for _, esp in pairs(gunESPObjects) do
                    if esp.Tool == tool then
                        hasESP = true
                        break
                    end
                end
                
                if not hasESP then
                    CreateGunESP(tool)
                end
            else
                -- If it's being held, remove ESP
                RemoveGunESP(tool)
            end
        end
    end
    
    -- Also check models that might be holding guns (like corpses)
    for _, model in pairs(Workspace:GetChildren()) do
        if model:IsA("Model") and model:FindFirstChild("Humanoid") then
            for _, tool in pairs(model:GetChildren()) do
                if tool:IsA("Tool") and tool.Name == "Gun" then
                    RemoveGunESP(tool)
                end
            end
        end
    end
    
    -- Clean up ESP for guns that no longer exist
    for i = #gunESPObjects, 1, -1 do
        local esp = gunESPObjects[i]
        if not esp.Tool or not esp.Tool.Parent or esp.Tool.Parent == nil then
            if esp.Billboard then esp.Billboard:Destroy() end
            table.remove(gunESPObjects, i)
        end
    end
end

-- ===== TOGGLE FUNCTIONS =====
local function ToggleESP()
    espEnabled = not espEnabled
    
    if espEnabled then
        for _, esp in pairs(espObjects) do
            if esp.Highlight then esp.Highlight:Destroy() end
        end
        espObjects = {}
        
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                CreateGlowESP(player)
            end
        end
        
        espConnection = RunService.RenderStepped:Connect(function()
            if espEnabled then
                UpdateGlowESP()
            end
        end)
        
        playerAddedConnection = Players.PlayerAdded:Connect(function(player)
            if espEnabled then
                task.wait(0.5)
                CreateGlowESP(player)
            end
        end)
        
        playerRemovedConnection = Players.PlayerRemoved:Connect(function(player)
            if espEnabled then
                RemoveGlowESP(player)
            end
        end)
        
        local function onCharacterAdded(player)
            if espEnabled then
                task.wait(0.5)
                RemoveGlowESP(player)
                CreateGlowESP(player)
            end
        end
        
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                player.CharacterAdded:Connect(function()
                    onCharacterAdded(player)
                end)
            end
        end
        
        characterAddedConnection = Players.PlayerAdded:Connect(function(player)
            player.CharacterAdded:Connect(function()
                onCharacterAdded(player)
            end)
        end)
        
        print("✅ Glow ESP Enabled")
    else
        if espConnection then espConnection:Disconnect() end
        if playerAddedConnection then playerAddedConnection:Disconnect() end
        if playerRemovedConnection then playerRemovedConnection:Disconnect() end
        if characterAddedConnection then characterAddedConnection:Disconnect() end
        
        for _, esp in pairs(espObjects) do
            if esp.Highlight then esp.Highlight:Destroy() end
        end
        espObjects = {}
        print("❌ Glow ESP Disabled")
    end
end

local function ToggleGunESP()
    gunESPEnabled = not gunESPEnabled
    
    if gunESPEnabled then
        -- Clear existing gun ESP
        for _, esp in pairs(gunESPObjects) do
            if esp.Billboard then esp.Billboard:Destroy() end
        end
        gunESPObjects = {}
        
        -- Initial scan
        ScanForDroppedGuns()
        
        -- Scan every frame
        gunScanConnection = RunService.RenderStepped:Connect(function()
            if gunESPEnabled then
                ScanForDroppedGuns()
            end
        end)
        
        -- Also scan when new objects are added
        toolAddedConnection = Workspace.ChildAdded:Connect(function(child)
            if gunESPEnabled then
                if child:IsA("Tool") and child.Name == "Gun" then
                    task.wait(0.1)
                    ScanForDroppedGuns()
                elseif child:IsA("Model") then
                    -- Check if model has guns
                    task.wait(0.1)
                    ScanForDroppedGuns()
                end
            end
        end)
        
        print("🔫 Gun ESP Enabled - Will show dropped guns!")
    else
        if gunScanConnection then gunScanConnection:Disconnect() end
        if toolAddedConnection then toolAddedConnection:Disconnect() end
        
        for _, esp in pairs(gunESPObjects) do
            if esp.Billboard then esp.Billboard:Destroy() end
        end
        gunESPObjects = {}
        print("❌ Gun ESP Disabled")
    end
end

-- ===== SIMPLE AIM FUNCTIONS =====
local function GetMurderer()
    for _, v in pairs(Players:GetPlayers()) do
        if v ~= LocalPlayer then
            if v.Backpack:FindFirstChild("Knife") or (v.Character and v.Character:FindFirstChild("Knife")) then
                return v
            end
        end
    end
    return nil
end

local function EquipGun()
    local gun = LocalPlayer.Backpack:FindFirstChild("Gun")
    if gun then
        LocalPlayer.Character.Humanoid:EquipTool(gun)
        return gun
    end
    return LocalPlayer.Character:FindFirstChild("Gun")
end

local function ShootMurderer()
    local murderer = GetMurderer()
    if not murderer or not murderer.Character then return end

    local targetHRP = murderer.Character:FindFirstChild("HumanoidRootPart")
    local myHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")

    if not targetHRP or not myHRP then return end

    local gun = EquipGun()
    if not gun then return end

    local shootRemote = gun:FindFirstChild("Shoot")
    if not shootRemote then return end

    local velocity = targetHRP.AssemblyLinearVelocity
    local predicted = targetHRP.Position + (velocity * prediction)
    predicted = predicted + Vector3.new(0, verticalOffset, 0)

    local args = {
        CFrame.new(myHRP.Position, predicted),
        CFrame.new(predicted)
    }
    shootRemote:FireServer(unpack(args))
end

-- ===== AUTO-SHOOT =====
local function AutoShootLoop()
    if not autoShoot then return end
    
    local murderer = GetMurderer()
    if murderer then
        local targetPos = murderer.Character:FindFirstChild("HumanoidRootPart")
        if targetPos then
            local screenPos, onScreen = Camera:WorldToViewportPoint(targetPos.Position)
            if onScreen then
                local distance = (Vector2.new(screenPos.X, screenPos.Y) - Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)).Magnitude
                if distance < fovRadius then
                    ShootMurderer()
                    task.wait(math.random(150, 350) / 1000)
                end
            end
        end
    end
end

