-- ===== ROLE HELPERS =====
local function GetPlayerRole(player)
    if not player or not player.Character then return "Unknown" end
    if player.Backpack:FindFirstChild("Knife") or (player.Character and player.Character:FindFirstChild("Knife")) then
        return "Murderer"
    end
    if player.Backpack:FindFirstChild("Gun") or (player.Character and player.Character:FindFirstChild("Gun")) then
        return "Sheriff"
    end
    local hasWeapon = false
    for _, tool in pairs(player.Backpack:GetChildren()) do
        if tool:IsA("Tool") then hasWeapon = true; break end
    end
    if not hasWeapon and player.Character then
        for _, tool in pairs(player.Character:GetChildren()) do
            if tool:IsA("Tool") then hasWeapon = true; break end
        end
    end
    return hasWeapon and "Unknown" or "Innocent"
end

local function GetRoleColor(role, isDead)
    if isDead then return Color3.fromRGB(120, 120, 120) end
    if role == "Murderer" then return Color3.fromRGB(255, 0, 0)
    elseif role == "Sheriff" then return Color3.fromRGB(0, 150, 255)
    elseif role == "Innocent" then return Color3.fromRGB(0, 255, 0)
    else return Color3.fromRGB(255, 255, 255) end
end

-- ===== GLOW ESP =====
local function CreateGlowESP(player)
    if not player or player == LocalPlayer or not player.Character then return end
    local character = player.Character
    local role = GetPlayerRole(player)
    local color = GetRoleColor(role, false)

    local highlight = Instance.new("Highlight")
    highlight.Name = "GlowESP_" .. player.Name
    highlight.Adornee = character
    highlight.FillColor = color
    highlight.FillTransparency = 0.5
    highlight.OutlineColor = color
    highlight.OutlineTransparency = 0.1
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = character

    table.insert(espObjects, {
        Player = player, Highlight = highlight, Color = color, LastRole = role
    })
end

local function UpdateGlowESP()
    if not espEnabled then return end
    for _, esp in pairs(espObjects) do
        local player = esp.Player
        if not player or not player.Character then
            if esp.Highlight then esp.Highlight:Destroy() end
            continue
        end
        local hum = player.Character:FindFirstChildOfClass("Humanoid")
        local dead = hum and hum.Health <= 0
        local role = GetPlayerRole(player)
        local color = GetRoleColor(role, dead)
        if esp.Highlight then
            esp.Highlight.FillColor = color
            esp.Highlight.OutlineColor = color
            esp.Color = color
            esp.LastRole = role
            -- Occlusion dim (cheap, only every 6 frames)
            if espOcclusionEnabled and esp._occlusionTick == nil then
                esp._occlusionTick = 0
            end
            if espOcclusionEnabled then
                esp._occlusionTick = (esp._occlusionTick or 0) + 1
                if esp._occlusionTick % 6 == 0 then
                    local hrp = player.Character:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        esp._occluded = not HasLineOfSight(hrp)
                    end
                end
                esp.Highlight.FillTransparency = esp._occluded and (0.5 + espOcclusionDim) or 0.5
            end
        end
    end
end

local function RemoveGlowESP(player)
    for i, esp in pairs(espObjects) do
        if esp.Player == player then
            if esp.Highlight then esp.Highlight:Destroy() end
            table.remove(espObjects, i)
            break
        end
    end
end

-- ===== LOS =====
local losParams = RaycastParams.new()
losParams.FilterType = Enum.RaycastFilterType.Exclude

function HasLineOfSight(targetHRP)
    local myHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myHRP or not targetHRP then return false end
    losParams.FilterDescendantsInstances = { LocalPlayer.Character }
    local hit = Workspace:Raycast(myHRP.Position, targetHRP.Position - myHRP.Position, losParams)
    if not hit then return true end
    return hit.Instance:IsDescendantOf(targetHRP.Parent)
end

-- ===== GUN ESP (debounced) =====
local function GetToolPosition(tool)
    if not tool then return nil end
    local handle = tool:FindFirstChild("Handle")
    if handle and handle:IsA("BasePart") then return handle.Position end
    for _, child in pairs(tool:GetChildren()) do
        if child:IsA("BasePart") then return child.Position end
    end
    return nil
end

local function IsToolHeld(tool, toolName)
    for _, player in pairs(Players:GetPlayers()) do
        local c = player.Character
        if c then
            for _, child in pairs(c:GetChildren()) do
                if child == tool then return true end
            end
            if c:FindFirstChild(toolName) == tool then return true end
        end
        local bp = player:FindFirstChildOfClass("Backpack")
        if bp and bp:FindFirstChild(toolName) == tool then return true end
    end
    local p = tool.Parent
    if p then
        if p:IsA("Model") and p:FindFirstChild("Humanoid") then return true end
        if p:IsA("Backpack") then return true end
        if p.Parent and p.Parent:IsA("Model") and p.Parent:FindFirstChild("Humanoid") then return true end
    end
    return false
end

local function CreateToolESP(tool, list, labelText, colorR, colorG, colorB)
