end

local function RemoveToolESP(tool, list)
    for i, esp in pairs(list) do
        if esp.Tool == tool then
            if esp.ESPPart then esp.ESPPart:Destroy() end
            if esp.Billboard then esp.Billboard:Destroy() end
            table.remove(list, i)
            break
        end
    end
end

local function ScanTools(list, toolName, createFrames, destroyFrames, enableFlag, label, colorR, colorG, colorB)
    if not enableFlag then return end
    local found = {}
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("Tool") and obj.Name == toolName then
            found[obj] = true
        end
    end

    -- Handle currently-found tools
    for tool in pairs(found) do
        local existing
        for _, esp in pairs(list) do
            if esp.Tool == tool then existing = esp; break end
        end
        if IsToolHeld(tool, toolName) then
            if existing then
                existing.DestroyCount = (existing.DestroyCount or 0) + 1
                existing.CreateCount = 0
                if existing.DestroyCount >= destroyFrames then
                    RemoveToolESP(tool, list)
                end
            end
        else
            if existing then
                existing.CreateCount = 0
                existing.DestroyCount = 0
            else
                -- Debounce: only create after tool is in Workspace for N frames
                local pending = list._pending or {}
                list._pending = pending
                pending[tool] = (pending[tool] or 0) + 1
                if pending[tool] >= createFrames then
                    pending[tool] = nil
                    CreateToolESP(tool, list, label, colorR, colorG, colorB)
                end
            end
        end
    end

    -- Cleanup missing
    for i = #list, 1, -1 do
        local esp = list[i]
        if esp and esp.Tool then
            if not esp.Tool.Parent or not found[esp.Tool] then
                if esp.ESPPart then esp.ESPPart:Destroy() end
                if esp.Billboard then esp.Billboard:Destroy() end
                table.remove(list, i)
            end
        end
    end
end

