-- ===== FLING =====
local function FlingPlayer(target)
    if not target or not target.Character then return end
    if flingCooldown then return end
    local targetHRP = target.Character:FindFirstChild("HumanoidRootPart")
    if not targetHRP then return end
    local isMurderer = target.Backpack:FindFirstChild("Knife") or (target.Character and target.Character:FindFirstChild("Knife"))
    if not isMurderer then
        print("⚠️ Target is not a murderer!")
        return
    end
    local myHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myHRP then return end
    local direction = (targetHRP.Position - myHRP.Position).Unit
    local velocity = direction * flingPower
    targetHRP.AssemblyLinearVelocity = velocity
    targetHRP.AssemblyLinearVelocity = targetHRP.AssemblyLinearVelocity + Vector3.new(0, 200, 0)
    flingCooldown = true
    task.wait(1)
    flingCooldown = false
    print("💥 Flinged " .. target.Name .. "!")
end

local function FlingMurderer()
    if flingCooldown then return end
    local murderer = nil
    for _, v in pairs(Players:GetPlayers()) do
        if v ~= LocalPlayer then
            if v.Backpack:FindFirstChild("Knife") or (v.Character and v.Character:FindFirstChild("Knife")) then
                murderer = v
                break
            end
        end
    end
    if murderer then FlingPlayer(murderer) else print("⚠️ No murderer found!") end
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if not flingEnabled then return end
    if input.KeyCode == Enum.KeyCode[flingKey] then FlingMurderer() end
end)

-- ===== ANTI-FLING (unchanged) =====
local antiFlingEnabled = false
local maxSafeVelocity = 100
local severeVelocityThreshold = 250
local maxSafeAngularVelocity = 50
local collisionRecoveryDelay = 0.3
local antiFlingConnection = nil
local lastSafePosition = nil
local lastSafeTime = 0
local ZERO_PHYSICS_OK, ZERO_PHYSICS = pcall(function()
    return PhysicalProperties.new(0.01, 0, 0, 0, 0)
end)
local collisionRecovery = {}

local function DisablePartCollisionTemporarily(part)
    part.CanCollide = false
    collisionRecovery[part] = tick() + collisionRecoveryDelay
end

local function NeutralizePart(part)
    DisablePartCollisionTemporarily(part)
    part.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
    part.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
    if ZERO_PHYSICS_OK then
        pcall(function() part.CustomPhysicalProperties = ZERO_PHYSICS end)
    end
end

local function RestoreSettledCollisions()
    local now = tick()
    for part, restoreAt in pairs(collisionRecovery) do
        if not part or not part.Parent then
            collisionRecovery[part] = nil
        elseif now >= restoreAt then
            part.CanCollide = true
            collisionRecovery[part] = nil
        end
    end
end

local function ToggleAntiFling()
    antiFlingEnabled = not antiFlingEnabled
    if antiFlingEnabled then
        lastSafePosition = nil
        lastSafeTime = tick()
        collisionRecovery = {}
        antiFlingConnection = RunService.Heartbeat:Connect(function()
            RestoreSettledCollisions()
            local character = LocalPlayer.Character
            if character then
                local hrp = character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    pcall(function() hrp:SetNetworkOwner(LocalPlayer) end)
                    for _, part in pairs(character:GetDescendants()) do
                        if part:IsA("BasePart") then
                            local partVel = part.AssemblyLinearVelocity
                            local partAngVel = part.AssemblyAngularVelocity
                            if partVel.Magnitude > maxSafeVelocity or partAngVel.Magnitude > maxSafeAngularVelocity then
                                DisablePartCollisionTemporarily(part)
                                part.AssemblyLinearVelocity = Vector3.new(0, math.max(partVel.Y, -50), 0)
                                part.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                            end
                        end
                    end
                    local vel = hrp.AssemblyLinearVelocity
                    local angVelMag = hrp.AssemblyAngularVelocity.Magnitude
                    if not speedEnabled then
                        if vel.Magnitude < maxSafeVelocity and angVelMag < maxSafeAngularVelocity then
                            lastSafePosition = hrp.Position
                            lastSafeTime = tick()
                        elseif lastSafePosition then
                            if vel.Magnitude > severeVelocityThreshold or angVelMag > severeVelocityThreshold then
                                hrp.CFrame = CFrame.new(lastSafePosition)
                                hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                                hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                                print("🛡️ Anti-Fling: severe fling neutralized, rescued back")
                            else
                                local distFromSafe = (hrp.Position - lastSafePosition).Magnitude
                                if distFromSafe > 150 then
                                    hrp.CFrame = CFrame.new(lastSafePosition)
                                    hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                                    print("🛡️ Anti-Fling: rescued back to last safe position")
                                end
                            end
                        end
                    end
                end
            end
            for _, player in pairs(Players:GetPlayers()) do
                if player ~= LocalPlayer and player.Character then
                    local theirHRP = player.Character:FindFirstChild("HumanoidRootPart")
                    if theirHRP then
                        local theirVel = theirHRP.AssemblyLinearVelocity
                        local theirAngVel = theirHRP.AssemblyAngularVelocity
                        if theirVel.Magnitude > maxSafeVelocity or theirAngVel.Magnitude > maxSafeAngularVelocity then
                            for _, part in pairs(player.Character:GetDescendants()) do
                                if part:IsA("BasePart") then NeutralizePart(part) end
                            end
                        end
                    end
                end
            end
        end)
        print("🛡️ Anti-Fling Enabled")
    else
        if antiFlingConnection then antiFlingConnection:Disconnect() end
        for part in pairs(collisionRecovery) do
            if part and part.Parent then part.CanCollide = true end
        end
        collisionRecovery = {}
        print("❌ Anti-Fling Disabled")
    end
end

