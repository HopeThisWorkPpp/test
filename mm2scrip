local Rayfield = loadstring(game:HttpGet("https://sirius.menu/rayfield"))()

local Window = Rayfield:CreateWindow({
    Name = "<@1465775865362387147>",
    LoadingTitle = "<@1465775865362387147>",
    LoadingSubtitle = "<@1465775865362387147>",
    ConfigurationSaving = {Enabled = false}
})

local Tab = Window:CreateTab("Main")

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local UserInputService = game:GetService("UserInputService")

local prediction = 0.22

-- Mobile button variables
local mobileButton = nil
local isMobile = UserInputService.TouchEnabled

local function GetMurderer()
    for _,v in pairs(Players:GetPlayers()) do
        if v ~= LocalPlayer then
            if v.Backpack:FindFirstChild("Knife") or (v.Character and v.Character:FindFirstChild("Knife")) then
                return v
            end
        end
    end
end

local function EquipGun()
    local gun = LocalPlayer.Backpack:FindFirstChild("Gun")
    if gun then
        LocalPlayer.Character.Humanoid:EquipTool(gun)
        return gun
    end
    return LocalPlayer.Character:FindFirstChild("Gun")
end

local function ShootMurderer()
    local murderer = GetMurderer()
    if not murderer or not murderer.Character then return end

    local targetHRP = murderer.Character:FindFirstChild("HumanoidRootPart")
    local myHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")

    if not targetHRP or not myHRP then return end

    local gun = EquipGun()
    if not gun then return end

    local shootRemote = gun:FindFirstChild("Shoot")
    if not shootRemote then return end

    local velocity = targetHRP.AssemblyLinearVelocity
    local predicted = targetHRP.Position + (velocity * prediction)

    predicted = predicted + Vector3.new(0,1.2,0)

    local args = {
        CFrame.new(myHRP.Position, predicted),
        CFrame.new(predicted)
    }
    shootRemote:FireServer(unpack(args))
end

-- PC Keybind (works for both PC and mobile but keyboard won't show on mobile)
Tab:CreateKeybind({
    Name = "Shoot Murderer (Keyboard)",
    CurrentKeybind = "Q",
    HoldToInteract = false,
    Callback = function()
        ShootMurderer()
    end
})

-- Mobile GUI Button (Only shows on mobile devices)
if isMobile then
    -- Create a screen GUI for the mobile button
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "MurderMysteryMobileGUI"
    screenGui.Parent = LocalPlayer.PlayerGui
    
    -- Create the shoot button frame
    local buttonFrame = Instance.new("Frame")
    buttonFrame.Size = UDim2.new(0, 120, 0, 120)
    buttonFrame.Position = UDim2.new(0.85, -60, 0.75, -60) -- Bottom right corner
    buttonFrame.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
    buttonFrame.BackgroundTransparency = 0.3
    buttonFrame.BorderSizePixel = 2
    buttonFrame.BorderColor3 = Color3.fromRGB(255, 255, 255)
    buttonFrame.Parent = screenGui
    
    -- Add corner rounding
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(1, 0) -- Makes it a circle
    corner.Parent = buttonFrame
    
    -- Add a text label
    local buttonLabel = Instance.new("TextLabel")
    buttonLabel.Size = UDim2.new(1, 0, 1, 0)
    buttonLabel.Position = UDim2.new(0, 0, 0, 0)
    buttonLabel.BackgroundTransparency = 1
    buttonLabel.Text = "🔫"
    buttonLabel.TextSize = 50
    buttonLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    buttonLabel.Font = Enum.Font.SourceSansBold
    buttonLabel.Parent = buttonFrame
    
    -- Add click detection
    local button = Instance.new("ImageButton")
    button.Size = UDim2.new(1, 0, 1, 0)
    button.Position = UDim2.new(0, 0, 0, 0)
    button.BackgroundTransparency = 1
    button.Parent = buttonFrame
    
    -- Button hover/press effects
    button.MouseEnter:Connect(function()
        buttonFrame.BackgroundTransparency = 0.2
    end)
    
    button.MouseLeave:Connect(function()
        buttonFrame.BackgroundTransparency = 0.3
    end)
    
    button.MouseButton1Down:Connect(function()
        buttonFrame.Size = UDim2.new(0, 110, 0, 110) -- Shrink slightly when pressed
    end)
    
    button.MouseButton1Up:Connect(function()
        buttonFrame.Size = UDim2.new(0, 120, 0, 120) -- Return to normal size
    end)
    
    -- The actual shoot function for mobile
    button.MouseButton1Click:Connect(function()
        ShootMurderer()
    end)
    
    -- Make button draggable (optional mobile feature)
    local dragging = false
    local dragStart = nil
    local startPos = nil
    
    button.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = buttonFrame.Position
        end
    end)
    
    button.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    
    button.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.Touch then
            local delta = input.Position - dragStart
            buttonFrame.Position = UDim2.new(
                startPos.X.Scale + (delta.X / game:GetService("GuiService").GetScreenResolution().X),
                0,
                startPos.Y.Scale + (delta.Y / game:GetService("GuiService").GetScreenResolution().Y),
                0
            )
        end
    end)
end

-- Status notification for mobile users
if isMobile then
    print("Mobile mode detected! Look for the red shoot button at the bottom right of your screen.")
end
