-- Zentynal Hub Visual Script Test
-- Confirms the "Visual Scripts" feature actually loads and runs.
-- Host this file somewhere raw-text-servable (GitHub raw, pastebin raw, etc.)
-- and paste that URL into the dashboard's Visual Scripts field.

local player = game:GetService("Players").LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- Remove any previous copy so re-running doesn't stack duplicates
local existing = playerGui:FindFirstChild("ZHVisualTest")
if existing then existing:Destroy() end

local screenGui = Instance.new("ScreenGui")
screenGui.Name = "ZHVisualTest"
screenGui.ResetOnSpawn = false
screenGui.Parent = playerGui

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 260, 0, 60)
frame.Position = UDim2.new(0.5, -130, 0, 20)
frame.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
frame.BorderSizePixel = 0
frame.Parent = screenGui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 10)
corner.Parent = frame

local label = Instance.new("TextLabel")
label.Size = UDim2.new(1, 0, 1, 0)
label.BackgroundTransparency = 1
label.Text = "✅ Zentynal Hub Visual Loaded"
label.TextColor3 = Color3.fromRGB(90, 220, 120)
label.TextScaled = true
label.Font = Enum.Font.GothamBold
label.Parent = frame

print("[ZH Visual Test] UI created successfully")

-- Auto-remove after 10 seconds so it doesn't linger
task.delay(10, function()
    if screenGui and screenGui.Parent then
        screenGui:Destroy()
    end
end)
