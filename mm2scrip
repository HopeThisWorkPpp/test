-- ===== FUNCTIONS =====

local function GetPlayerRole(player)
    if not player or not player.Character then return "Unknown" end
    
    if player.Backpack:FindFirstChild("Knife") or (player.Character and player.Character:FindFirstChild("Knife")) then
        return "Murderer"
    end
    
    if player.Backpack:FindFirstChild("Gun") or (player.Character and player.Character:FindFirstChild("Gun")) then
        return "Sheriff"
    end
    
    local hasWeapon = false
    for _, tool in pairs(player.Backpack:GetChildren()) do
        if tool:IsA("Tool") then
            hasWeapon = true
            break
        end
    end
    if not hasWeapon then
        for _, tool in pairs(player.Character:GetChildren()) do
            if tool:IsA("Tool") then
                hasWeapon = true
                break
            end
        end
    end
    
    return hasWeapon and "Unknown" or "Innocent"
end

local function GetRoleColor(role)
    if role == "Murderer" then return Color3.fromRGB(255, 0, 0)
    elseif role == "Sheriff" then return Color3.fromRGB(0, 150, 255)
    elseif role == "Innocent" then return Color3.fromRGB(0, 255, 0)
    else return Color3.fromRGB(255, 255, 255) end
end

-- ===== GLOW ESP FUNCTIONS =====
local function CreateGlowESP(player)
    if not player or player == LocalPlayer or not player.Character then return end
    
    local character = player.Character
    local role = GetPlayerRole(player)
    local color = GetRoleColor(role)
    
    -- Create Highlight for glow effect
    local highlight = Instance.new("Highlight")
    highlight.Name = "GlowESP_" .. player.Name
    highlight.Adornee = character
    highlight.FillColor = color
    highlight.FillTransparency = 0.5
    highlight.OutlineColor = color
    highlight.OutlineTransparency = 0.1
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = character
    
    table.insert(espObjects, {
        Player = player,
        Highlight = highlight,
        Color = color
    })
end

local function UpdateGlowESP()
    if not espEnabled then return end
    
    for _, esp in pairs(espObjects) do
        local player = esp.Player
        if not player or not player.Character then
            if esp.Highlight then esp.Highlight:Destroy() end
            continue
        end
        
        local role = GetPlayerRole(player)
        local color = GetRoleColor(role)
        
        if esp.Highlight then
            esp.Highlight.FillColor = color
            esp.Highlight.OutlineColor = color
            esp.Color = color
        end
    end
end

local function RemoveGlowESP(player)
    for i, esp in pairs(espObjects) do
        if esp.Player == player then
            if esp.Highlight then esp.Highlight:Destroy() end
            table.remove(espObjects, i)
            break
        end
    end
end

-- Toggle ESP
local function ToggleESP()
    espEnabled = not espEnabled
    
    if espEnabled then
        -- Clear existing
        for _, esp in pairs(espObjects) do
            if esp.Highlight then esp.Highlight:Destroy() end
        end
        espObjects = {}
        
        -- Create ESP for all players
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                CreateGlowESP(player)
            end
        end
        
        -- Start update loop
        espConnection = RunService.RenderStepped:Connect(function()
            if espEnabled then
                UpdateGlowESP()
            end
        end)
        
        -- Player added
        playerAddedConnection = Players.PlayerAdded:Connect(function(player)
            if espEnabled then
                task.wait(0.5)
                CreateGlowESP(player)
            end
        end)
        
        -- Player removed
        playerRemovedConnection = Players.PlayerRemoved:Connect(function(player)
            if espEnabled then
                RemoveGlowESP(player)
            end
        end)
        
        -- Character added for role changes
        local function onCharacterAdded(player)
            if espEnabled then
                task.wait(0.5)
                RemoveGlowESP(player)
                CreateGlowESP(player)
            end
        end
        
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                player.CharacterAdded:Connect(function()
                    onCharacterAdded(player)
                end)
            end
        end
        
        characterAddedConnection = Players.PlayerAdded:Connect(function(player)
            player.CharacterAdded:Connect(function()
                onCharacterAdded(player)
            end)
        end)
        
        print("Glow ESP Enabled - 🔴Murderer | 🔵Sheriff | 🟢Innocent")
    else
        -- Disable ESP
        if espConnection then espConnection:Disconnect() end
        if playerAddedConnection then playerAddedConnection:Disconnect() end
        if playerRemovedConnection then playerRemovedConnection:Disconnect() end
        if characterAddedConnection then characterAddedConnection:Disconnect() end
        
        for _, esp in pairs(espObjects) do
            if esp.Highlight then esp.Highlight:Destroy() end
        end
        espObjects = {}
        print("Glow ESP Disabled")
    end
end

-- ===== AIM FUNCTIONS =====
local function GetMurderer()
    local bestTarget = nil
    local bestDistance = math.huge
    
    for _, v in pairs(Players:GetPlayers()) do
        if v ~= LocalPlayer and v.Character then
            local hasKnife = v.Backpack:FindFirstChild("Knife") or (v.Character and v.Character:FindFirstChild("Knife"))
            if hasKnife then
                if autoShoot then
                    local targetPos = v.Character:FindFirstChild("HumanoidRootPart")
                    if targetPos then
                        local screenPos, onScreen = Camera:WorldToViewportPoint(targetPos.Position)
                        if onScreen then
                            local distance = (Vector2.new(screenPos.X, screenPos.Y) - Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)).Magnitude
                            if distance < fovRadius and distance < bestDistance then
                                bestDistance = distance
                                bestTarget = v
                            end
                        end
                    end
                else
                    return v
                end
            end
        end
    end
    
    return bestTarget
end

local function EquipGun()
    local gun = LocalPlayer.Backpack:FindFirstChild("Gun")
    if gun then
        LocalPlayer.Character.Humanoid:EquipTool(gun)
        return gun
    end
    return LocalPlayer.Character:FindFirstChild("Gun")
end

local function ShootMurderer()
    local murderer = GetMurderer()
    if not murderer or not murderer.Character then return end

    local targetHRP = murderer.Character:FindFirstChild("HumanoidRootPart")
    local myHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")

    if not targetHRP or not myHRP then return end

    local gun = EquipGun()
    if not gun then return end

    local shootRemote = gun:FindFirstChild("Shoot")
    if not shootRemote then return end

    -- AIM PREDICTION
    local targetPos = targetHRP.Position
    local velocity = targetHRP.AssemblyLinearVelocity
    local humanoid = murderer.Character:FindFirstChild("Humanoid")
    
    local predicted = targetPos + (velocity * prediction)
    
    -- Jump detection
    local isJumping = humanoid and humanoid:GetState() == Enum.HumanoidStateType.Jumping
    if isJumping then
        local jumpHeight = 3.5
        predicted = predicted + Vector3.new(0, jumpHeight, 0)
        
        local verticalVelocity = velocity.Y
        if verticalVelocity > 0 then
            predicted = predicted + Vector3.new(0, verticalVelocity * 0.15, 0)
        elseif verticalVelocity < 0 then
            predicted = predicted + Vector3.new(0, verticalVelocity * 0.1, 0)
        end
    else
        predicted = predicted + Vector3.new(0, verticalOffset, 0)
    end
    
    -- Running prediction
    local horizontalSpeed = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
    if horizontalSpeed > 10 then
        predicted = predicted + (velocity * 0.05 * 1.2)
    end

    -- Fire
    local args = {
        CFrame.new(myHRP.Position, predicted),
        CFrame.new(predicted)
    }
    shootRemote:FireServer(unpack(args))
end

-- ===== AUTO-SHOOT =====
local function AutoShootLoop()
    if not autoShoot then return end
    
    local murderer = GetMurderer()
    if murderer then
        ShootMurderer()
        task.wait(math.random(100, 300) / 1000)
    end
end

-- ===== MOBILE GUI =====
local function CreateMobileGUI()
    if mobileGUI then mobileGUI:Destroy() end
    
    mobileGUI = Instance.new("ScreenGui")
    mobileGUI.Name = "MM2MobileGUI"
    mobileGUI.ResetOnSpawn = false
    mobileGUI.IgnoreGuiInset = true
    mobileGUI.Parent = LocalPlayer.PlayerGui
    
    buttonFrame = Instance.new("Frame")
    buttonFrame.Size = UDim2.new(0, 120, 0, 120)
    buttonFrame.Position = UDim2.new(0.85, -60, 0.75, -60)
    buttonFrame.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
    buttonFrame.BackgroundTransparency = 0.3
    buttonFrame.BorderSizePixel = 2
    buttonFrame.BorderColor3 = Color3.fromRGB(255, 255, 255)
    buttonFrame.Parent = mobileGUI
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(1, 0)
    corner.Parent = buttonFrame
    
    local buttonLabel = Instance.new("TextLabel")
    buttonLabel.Size = UDim2.new(1, 0, 1, 0)
    buttonLabel.BackgroundTransparency = 1
    buttonLabel.Text = "🔫"
    buttonLabel.TextSize = 50
    buttonLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    buttonLabel.Font = Enum.Font.SourceSansBold
    buttonLabel.Parent = buttonFrame
    
    local button = Instance.new("ImageButton")
    button.Size = UDim2.new(1, 0, 1, 0)
    button.BackgroundTransparency = 1
    button.Parent = buttonFrame
    
    button.MouseButton1Click:Connect(function()
        if autoShoot then
            print("Auto-shoot is on! Toggle it off for manual shooting.")
        else
            ShootMurderer()
        end
    end)
    
    -- Draggable
    local dragging = false
    local dragStart, startPos
    
    button.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = buttonFrame.Position
        end
    end)
    
    button.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    
    button.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.Touch then
            local delta = input.Position - dragStart
            local viewportSize = game:GetService("GuiService"):GetScreenResolution()
            buttonFrame.Position = UDim2.new(
                startPos.X.Scale + (delta.X / viewportSize.X),
                0,
                startPos.Y.Scale + (delta.Y / viewportSize.Y),
                0
            )
        end
    end)
end

