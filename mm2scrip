-- ===== ANTI-FLING =====
local antiFlingEnabled = false
local maxSafeVelocity = 100 -- studs/s, above normal walk/jump/knockback range
local antiFlingConnection = nil

local function ToggleAntiFling()
    antiFlingEnabled = not antiFlingEnabled

    if antiFlingEnabled then
        antiFlingConnection = RunService.Heartbeat:Connect(function()
            local character = LocalPlayer.Character
            if not character then return end
            local hrp = character:FindFirstChild("HumanoidRootPart")
            if not hrp then return end

            local vel = hrp.AssemblyLinearVelocity
            if vel.Magnitude > maxSafeVelocity then
                -- Kill the excess velocity but keep some downward pull so you
                -- don't look like you're floating/frozen mid-air.
                hrp.AssemblyLinearVelocity = Vector3.new(0, math.max(vel.Y, -50), 0)
            end
        end)
        print("🛡️ Anti-Fling Enabled")
    else
        if antiFlingConnection then antiFlingConnection:Disconnect() end
        print("❌ Anti-Fling Disabled")
    end
end

-- ===== TOGGLE FUNCTIONS =====
local function ToggleESP()
    espEnabled = not espEnabled
    
    if espEnabled then
        for _, esp in pairs(espObjects) do
            if esp.Highlight then esp.Highlight:Destroy() end
        end
        espObjects = {}
        
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                CreateGlowESP(player)
            end
        end
        
        espConnection = RunService.RenderStepped:Connect(function()
            if espEnabled then
                UpdateGlowESP()
            end
        end)
        
        playerAddedConnection = Players.PlayerAdded:Connect(function(player)
            if espEnabled then
                task.wait(0.5)
                CreateGlowESP(player)
            end
        end)
        
        playerRemovedConnection = Players.PlayerRemoved:Connect(function(player)
            if espEnabled then
                RemoveGlowESP(player)
            end
        end)
        
        local function onCharacterAdded(player)
            if espEnabled then
                task.wait(0.5)
                RemoveGlowESP(player)
                CreateGlowESP(player)
            end
        end
        
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                player.CharacterAdded:Connect(function()
                    onCharacterAdded(player)
                end)
            end
        end
        
        characterAddedConnection = Players.PlayerAdded:Connect(function(player)
            player.CharacterAdded:Connect(function()
                onCharacterAdded(player)
            end)
        end)
        
        print("✅ Glow ESP Enabled")
    else
        if espConnection then espConnection:Disconnect() end
        if playerAddedConnection then playerAddedConnection:Disconnect() end
        if playerRemovedConnection then playerRemovedConnection:Disconnect() end
        if characterAddedConnection then characterAddedConnection:Disconnect() end
        
        for _, esp in pairs(espObjects) do
            if esp.Highlight then esp.Highlight:Destroy() end
        end
        espObjects = {}
        print("❌ Glow ESP Disabled")
    end
end

local function ToggleGunESP()
    gunESPEnabled = not gunESPEnabled
    
    if gunESPEnabled then
        -- Clear existing gun ESP
        for _, esp in pairs(gunESPObjects) do
            if esp.ESPPart then esp.ESPPart:Destroy() end
            if esp.Billboard then esp.Billboard:Destroy() end
        end
        gunESPObjects = {}
        
        -- Initial scan
        ScanForDroppedGuns()
        
        -- Scan every frame
        gunScanConnection = RunService.RenderStepped:Connect(function()
            if gunESPEnabled then
                ScanForDroppedGuns()
            end
        end)
        
        -- Also scan when new objects are added
        toolAddedConnection = Workspace.DescendantAdded:Connect(function(child)
            if gunESPEnabled then
                if child:IsA("Tool") and child.Name == "Gun" then
                    task.wait(0.1)
                    ScanForDroppedGuns()
                end
            end
        end)
        
        print("🔫 Gun ESP Enabled - Will show dropped guns!")
    else
        if gunScanConnection then gunScanConnection:Disconnect() end
        if toolAddedConnection then toolAddedConnection:Disconnect() end
        
        for _, esp in pairs(gunESPObjects) do
            if esp.ESPPart then esp.ESPPart:Destroy() end
            if esp.Billboard then esp.Billboard:Destroy() end
        end
        gunESPObjects = {}
        print("❌ Gun ESP Disabled")
    end
end

