    end
    
    mobileGUI = Instance.new("ScreenGui")
    mobileGUI.Name = "MurderMysteryMobileGUI"
    mobileGUI.ResetOnSpawn = false
    mobileGUI.IgnoreGuiInset = true
    mobileGUI.Parent = LocalPlayer.PlayerGui
    
    buttonFrame = Instance.new("Frame")
    buttonFrame.Size = UDim2.new(0, 120, 0, 120)
    buttonFrame.Position = UDim2.new(0.85, -60, 0.75, -60)
    buttonFrame.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
    buttonFrame.BackgroundTransparency = 0.3
    buttonFrame.BorderSizePixel = 2
    buttonFrame.BorderColor3 = Color3.fromRGB(255, 255, 255)
    buttonFrame.Parent = mobileGUI
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(1, 0)
    corner.Parent = buttonFrame
    
    local buttonLabel = Instance.new("TextLabel")
    buttonLabel.Size = UDim2.new(1, 0, 1, 0)
    buttonLabel.Position = UDim2.new(0, 0, 0, 0)
    buttonLabel.BackgroundTransparency = 1
    buttonLabel.Text = "🔫"
    buttonLabel.TextSize = 50
    buttonLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    buttonLabel.Font = Enum.Font.SourceSansBold
    buttonLabel.Parent = buttonFrame
    
    local button = Instance.new("ImageButton")
    button.Size = UDim2.new(1, 0, 1, 0)
    button.Position = UDim2.new(0, 0, 0, 0)
    button.BackgroundTransparency = 1
    button.Parent = buttonFrame
    
    button.MouseEnter:Connect(function()
        if buttonFrame then
            buttonFrame.BackgroundTransparency = 0.2
        end
    end)
    
    button.MouseLeave:Connect(function()
        if buttonFrame then
            buttonFrame.BackgroundTransparency = 0.3
        end
    end)
    
    button.MouseButton1Down:Connect(function()
        if buttonFrame then
            buttonFrame.Size = UDim2.new(0, 110, 0, 110)
        end
    end)
    
    button.MouseButton1Up:Connect(function()
        if buttonFrame then
            buttonFrame.Size = UDim2.new(0, 120, 0, 120)
        end
    end)
    
    button.MouseButton1Click:Connect(function()
        ShootMurderer()
    end)
    
    -- Draggable functionality
    local dragging = false
    local dragStart = nil
    local startPos = nil
    
    button.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = buttonFrame.Position
        end
    end)
    
    button.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    
    button.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.Touch then
            local delta = input.Position - dragStart
            local viewportSize = game:GetService("GuiService"):GetScreenResolution()
            buttonFrame.Position = UDim2.new(
                startPos.X.Scale + (delta.X / viewportSize.X),
                0,
                startPos.Y.Scale + (delta.Y / viewportSize.Y),
                0
            )
        end
    end)
end

