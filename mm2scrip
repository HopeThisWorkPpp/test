-- SCAN FOR DROPPED GUNS - Scans EVERYTHING constantly
local function ScanForDroppedGuns()
    if not gunESPEnabled then return end
    
    local foundGuns = {}
    
    -- Search EVERYTHING in workspace
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("Tool") and obj.Name == "Gun" then
            table.insert(foundGuns, obj)
        end
    end
    
    -- Check each gun
    for _, gun in pairs(foundGuns) do
        local isHeld = false
        
        -- Check ALL players
        for _, player in pairs(Players:GetPlayers()) do
            if player.Character then
                -- Check if gun is in character's tools
                for _, child in pairs(player.Character:GetChildren()) do
                    if child == gun then
                        isHeld = true
                        break
                    end
                end
                -- Check if gun is being held (in the character's hand)
                if player.Character:FindFirstChild("Gun") == gun then
                    isHeld = true
                end
            end
            if player.Backpack then
                if player.Backpack:FindFirstChild("Gun") == gun then
                    isHeld = true
                end
            end
        end
        
        -- Check parent chain
        if gun.Parent then
            if gun.Parent:IsA("Model") and gun.Parent:FindFirstChild("Humanoid") then
                isHeld = true
            end
            if gun.Parent:IsA("Backpack") then
                isHeld = true
            end
            -- Check if parent's parent is a character
            if gun.Parent.Parent and gun.Parent.Parent:IsA("Model") and gun.Parent.Parent:FindFirstChild("Humanoid") then
                isHeld = true
            end
        end
        
        if not isHeld then
            -- Check if we already have ESP for this gun
            local hasESP = false
            for _, esp in pairs(gunESPObjects) do
                if esp.Tool == gun then
                    hasESP = true
                    break
                end
            end
            
            if not hasESP then
                CreateGunESP(gun)
            end
        else
            -- If held, remove ESP
            RemoveGunESP(gun)
        end
    end
    
    -- Clean up ESP for guns that no longer exist
    for i = #gunESPObjects, 1, -1 do
        local esp = gunESPObjects[i]
        if not esp.Tool or not esp.Tool.Parent then
            if esp.ESPPart then esp.ESPPart:Destroy() end
            if esp.Billboard then esp.Billboard:Destroy() end
            table.remove(gunESPObjects, i)
        end
    end
end

-- ===== FLING FUNCTIONS =====
local function FlingPlayer(target)
    if not target or not target.Character then return end
    if flingCooldown then return end
    
    local targetHRP = target.Character:FindFirstChild("HumanoidRootPart")
    if not targetHRP then return end
    
    -- Check if target is murderer
    local isMurderer = target.Backpack:FindFirstChild("Knife") or (target.Character and target.Character:FindFirstChild("Knife"))
    if not isMurderer then
        print("⚠️ Target is not a murderer!")
        return
    end
    
    -- Get direction from player to target
    local myHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myHRP then return end
    
    local direction = (targetHRP.Position - myHRP.Position).Unit
    local velocity = direction * flingPower
    
    -- Apply velocity to target
    targetHRP.AssemblyLinearVelocity = velocity
    
    -- Add some upward velocity for extra fling
    targetHRP.AssemblyLinearVelocity = targetHRP.AssemblyLinearVelocity + Vector3.new(0, 200, 0)
    
    -- Cooldown
    flingCooldown = true
    task.wait(1)
    flingCooldown = false
    
    print("💥 Flinged " .. target.Name .. "!")
end

local function FlingMurderer()
    if flingCooldown then return end
    
    local murderer = nil
    for _, v in pairs(Players:GetPlayers()) do
        if v ~= LocalPlayer then
            if v.Backpack:FindFirstChild("Knife") or (v.Character and v.Character:FindFirstChild("Knife")) then
                murderer = v
                break
            end
        end
    end
    
    if murderer then
        FlingPlayer(murderer)
    else
        print("⚠️ No murderer found!")
    end
end

