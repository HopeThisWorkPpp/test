    frame.BackgroundColor3 = Color3.fromRGB(colorR, colorG, colorB)
    frame.BackgroundTransparency = 0.1
    frame.BorderSizePixel = 3
    frame.BorderColor3 = Color3.fromRGB(255, 255, 255)
    frame.Parent = billboard

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 10)
    corner.Parent = frame

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = labelText
    label.TextSize = 20
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.Font = Enum.Font.SourceSansBold
    label.TextStrokeTransparency = 0.1
    label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    label.Parent = frame

    local distanceLabel = Instance.new("TextLabel")
    distanceLabel.Size = UDim2.new(1, 0, 0, 20)
    distanceLabel.Position = UDim2.new(0, 0, 1.3, 0)
    distanceLabel.BackgroundTransparency = 1
    distanceLabel.Text = ""
    distanceLabel.TextSize = 14
    distanceLabel.TextColor3 = Color3.fromRGB(255, 255, 200)
    distanceLabel.Font = Enum.Font.SourceSans
    distanceLabel.TextStrokeTransparency = 0.3
    distanceLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    distanceLabel.Parent = billboard

    local arrow = Instance.new("TextLabel")
    arrow.Size = UDim2.new(0, 30, 0, 30)
    arrow.Position = UDim2.new(0.5, -15, -1.5, 0)
    arrow.BackgroundTransparency = 1
    arrow.Text = "⬇"
    arrow.TextSize = 30
    arrow.TextColor3 = Color3.fromRGB(colorR, colorG, colorB)
    arrow.Font = Enum.Font.SourceSansBold
    arrow.Parent = billboard

    local entry = {
        Tool = tool, ESPPart = espPart, Billboard = billboard,
        Frame = frame, Label = label, DistanceLabel = distanceLabel, Arrow = arrow,
        CreateCount = 0, DestroyCount = 0,
    }
    table.insert(list, entry)

    spawn(function()
        local startTime = tick()
        while billboard and billboard.Parent do
            local pulse = 0.5 + 0.5 * math.sin((tick() - startTime) * 2)
            if frame then
                frame.BackgroundTransparency = 0.1 + 0.2 * pulse
                frame.BorderColor3 = Color3.fromRGB(colorR, 200 + 55 * pulse, colorB)
            end
            if arrow then
                arrow.Position = UDim2.new(0.5, -15, -1.5 - 0.2 * pulse, 0)
            end
            local myChar = LocalPlayer.Character
            local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
            if distanceLabel then
                if myHRP then
                    local tp = GetToolPosition(tool)
                    if tp then
                        distanceLabel.Text = math.floor((myHRP.Position - tp).Magnitude) .. " studs"
                    end
                else
                    distanceLabel.Text = ""
                end
            end
            task.wait(0.05)
        end
