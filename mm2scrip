-- ===== ANTI-FLING =====
local antiFlingEnabled = false
local maxSafeVelocity = 100 -- studs/s, above normal walk/jump/knockback range
local antiFlingConnection = nil
local antiFlingCharacterConnection = nil
local lastSafePosition = nil
local lastSafeTime = 0
local originalCollide = {} -- so we can restore real CanCollide values on toggle-off

-- Ground detection on modern Roblox uses the Humanoid's own sensor system,
-- not physical part collision, so setting CanCollide = false on your whole
-- character is safe — you won't fall through the floor, but other players'
-- physics can no longer shove/collide into you at all, which is the root
-- cause of a lot of flings (not just a symptom of it).
local function DisableCharacterCollision(character)
    for _, part in pairs(character:GetDescendants()) do
        if part:IsA("BasePart") then
            originalCollide[part] = part.CanCollide
            part.CanCollide = false
        end
    end
end

local function RestoreCharacterCollision()
    for part, wasCollidable in pairs(originalCollide) do
        if part and part.Parent then
            part.CanCollide = wasCollidable
        end
    end
    originalCollide = {}
end

local function ToggleAntiFling()
    antiFlingEnabled = not antiFlingEnabled

    if antiFlingEnabled then
        lastSafePosition = nil
        lastSafeTime = tick()

        if LocalPlayer.Character then
            DisableCharacterCollision(LocalPlayer.Character)
        end

        -- Character parts reset to default CanCollide on every respawn, so
        -- reapply whenever a new character loads in while this is still on.
        antiFlingCharacterConnection = LocalPlayer.CharacterAdded:Connect(function(newCharacter)
            if not antiFlingEnabled then return end
            newCharacter:WaitForChild("HumanoidRootPart", 5)
            DisableCharacterCollision(newCharacter)
        end)

        antiFlingConnection = RunService.Heartbeat:Connect(function()
            local character = LocalPlayer.Character
            if not character then return end
            local hrp = character:FindFirstChild("HumanoidRootPart")
            if not hrp then return end

            -- Force network ownership of your own character back to
            -- yourself every frame. Most flings work by momentarily gaining
            -- ownership of your HRP (often via a physics collision) and
            -- setting velocity on it while they own it — if another client
            -- never holds ownership, they can't move your part at all. The
            -- velocity clamp below is just a backup for the single frame
            -- before ownership fully re-settles.
            pcall(function()
                hrp:SetNetworkOwner(LocalPlayer)
            end)

            -- Zero excess velocity on EVERY part, not just the HRP — some
            -- flings apply force to a limb or the torso instead of (or in
            -- addition to) the root part.
            for _, part in pairs(character:GetDescendants()) do
                if part:IsA("BasePart") then
                    local partVel = part.AssemblyLinearVelocity
                    if partVel.Magnitude > maxSafeVelocity then
                        part.AssemblyLinearVelocity = Vector3.new(0, math.max(partVel.Y, -50), 0)
                    end
                end
            end

            local vel = hrp.AssemblyLinearVelocity

            -- Safety net: this catches flings regardless of *how* they
            -- happen (velocity, ownership theft, or even a server-side
            -- remote we can't otherwise touch). Remember the last position
            -- you were at while moving normally; if you ever show up far
            -- from that spot, snap back instead of riding it into a kill
            -- zone or the void. Skips the check while your own Super Speed
            -- is on so it doesn't fight your legit fast movement.
            if not speedEnabled then
                if vel.Magnitude < maxSafeVelocity then
                    lastSafePosition = hrp.Position
                    lastSafeTime = tick()
                elseif lastSafePosition then
                    local distFromSafe = (hrp.Position - lastSafePosition).Magnitude
                    -- No time window here on purpose: lastSafePosition only
                    -- ever updates while velocity is normal, so it stays
                    -- frozen at your last real safe spot for as long as a
                    -- fling keeps going — including repeated/sustained
                    -- flinging that never lets velocity drop long enough to
                    -- refresh it. Distance alone is what matters.
                    if distFromSafe > 150 then
                        hrp.CFrame = CFrame.new(lastSafePosition)
                        hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                        print("🛡️ Anti-Fling: rescued back to last safe position")
                    end
                end
            end
        end)
        print("🛡️ Anti-Fling Enabled (collision disabled)")
    else
        if antiFlingConnection then antiFlingConnection:Disconnect() end
        if antiFlingCharacterConnection then antiFlingCharacterConnection:Disconnect() end
        RestoreCharacterCollision()
        print("❌ Anti-Fling Disabled")
    end
end

-- ===== TOGGLE FUNCTIONS =====
local function ToggleESP()
    espEnabled = not espEnabled
    
    if espEnabled then
        for _, esp in pairs(espObjects) do
            if esp.Highlight then esp.Highlight:Destroy() end
        end
        espObjects = {}
        
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                CreateGlowESP(player)
            end
        end
        
        espConnection = RunService.RenderStepped:Connect(function()
            if espEnabled then
                UpdateGlowESP()
            end
        end)
        
        playerAddedConnection = Players.PlayerAdded:Connect(function(player)
            if espEnabled then
                task.wait(0.5)
                CreateGlowESP(player)
            end
        end)
        
        playerRemovedConnection = Players.PlayerRemoved:Connect(function(player)
            if espEnabled then
                RemoveGlowESP(player)
            end
        end)
        
        local function onCharacterAdded(player)
            if espEnabled then
                task.wait(0.5)
                RemoveGlowESP(player)
                CreateGlowESP(player)
            end
        end
        
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                player.CharacterAdded:Connect(function()
                    onCharacterAdded(player)
                end)
            end
        end
        
        characterAddedConnection = Players.PlayerAdded:Connect(function(player)
            player.CharacterAdded:Connect(function()
                onCharacterAdded(player)
            end)
        end)
        
        print("✅ Glow ESP Enabled")
    else
        if espConnection then espConnection:Disconnect() end
        if playerAddedConnection then playerAddedConnection:Disconnect() end
        if playerRemovedConnection then playerRemovedConnection:Disconnect() end
        if characterAddedConnection then characterAddedConnection:Disconnect() end
        
        for _, esp in pairs(espObjects) do
            if esp.Highlight then esp.Highlight:Destroy() end
        end
        espObjects = {}
        print("❌ Glow ESP Disabled")
    end
end

local function ToggleGunESP()
    gunESPEnabled = not gunESPEnabled
    
    if gunESPEnabled then
        -- Clear existing gun ESP
        for _, esp in pairs(gunESPObjects) do
            if esp.ESPPart then esp.ESPPart:Destroy() end
            if esp.Billboard then esp.Billboard:Destroy() end
        end
        gunESPObjects = {}
        
        -- Initial scan
        ScanForDroppedGuns()
        
        -- Scan every frame
        gunScanConnection = RunService.RenderStepped:Connect(function()
            if gunESPEnabled then
                ScanForDroppedGuns()
            end
        end)
        
        -- Also scan when new objects are added
        toolAddedConnection = Workspace.DescendantAdded:Connect(function(child)
            if gunESPEnabled then
                if child:IsA("Tool") and child.Name == "Gun" then
                    task.wait(0.1)
                    ScanForDroppedGuns()
                end
            end
        end)
        
        print("🔫 Gun ESP Enabled - Will show dropped guns!")
    else
        if gunScanConnection then gunScanConnection:Disconnect() end
        if toolAddedConnection then toolAddedConnection:Disconnect() end
        
        for _, esp in pairs(gunESPObjects) do
            if esp.ESPPart then esp.ESPPart:Destroy() end
            if esp.Billboard then esp.Billboard:Destroy() end
        end
        gunESPObjects = {}
        print("❌ Gun ESP Disabled")
    end
end

