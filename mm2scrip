-- Function to get player role
local function GetPlayerRole(player)
    if not player or not player.Character then return "Unknown" end
    
    if player.Backpack:FindFirstChild("Knife") or (player.Character and player.Character:FindFirstChild("Knife")) then
        return "Murderer"
    end
    
    if player.Backpack:FindFirstChild("Gun") or (player.Character and player.Character:FindFirstChild("Gun")) then
        return "Sheriff"
    end
    
    local hasWeapon = false
    for _, tool in pairs(player.Backpack:GetChildren()) do
        if tool:IsA("Tool") then
            hasWeapon = true
            break
        end
    end
    if not hasWeapon then
        for _, tool in pairs(player.Character:GetChildren()) do
            if tool:IsA("Tool") then
                hasWeapon = true
                break
            end
        end
    end
    
    if not hasWeapon then
        return "Innocent"
    end
    
    return "Unknown"
end

-- Function to get color for role
local function GetRoleColor(role)
    if role == "Murderer" then
        return Color3.fromRGB(255, 0, 0)
    elseif role == "Sheriff" then
        return Color3.fromRGB(0, 150, 255)
    elseif role == "Innocent" then
        return Color3.fromRGB(0, 255, 0)
    else
        return Color3.fromRGB(255, 255, 255)
    end
end

-- Create ESP outline for a player
local function CreateESP(player)
    if not player or player == LocalPlayer then return end
    if not player.Character then return end
    
    local character = player.Character
    local rootPart = character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
    if not rootPart then return end
    
    local role = GetPlayerRole(player)
    local color = GetRoleColor(role)
    
    local boxOutline = Instance.new("BoxHandleAdornment")
    boxOutline.Name = "BoxESP_" .. player.Name
    boxOutline.Size = Vector3.new(3.5, 5, 1.5)
    boxOutline.Adornee = rootPart
    boxOutline.AlwaysOnTop = true
    boxOutline.ZIndex = 0
    boxOutline.Transparency = 0.2
    boxOutline.Color3 = color
    boxOutline.Parent = character
    
    table.insert(espObjects, {
        Player = player,
        Box = boxOutline,
        RootPart = rootPart
    })
end

-- Update ESP color for a player
local function UpdateESPColor(player)
    if not player then return end
    
    local role = GetPlayerRole(player)
    local color = GetRoleColor(role)
    
    for _, esp in pairs(espObjects) do
        if esp.Player == player and esp.Box then
            esp.Box.Color3 = color
            break
        end
    end
end

-- Remove ESP for a player
local function RemoveESP(player)
    for i, esp in pairs(espObjects) do
        if esp.Player == player then
            if esp.Box then esp.Box:Destroy() end
            table.remove(espObjects, i)
            break
        end
    end
end

-- Update all ESPs
local function UpdateAllESP()
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local hasESP = false
            local espToUpdate = nil
            
            for _, esp in pairs(espObjects) do
                if esp.Player == player then
                    hasESP = true
                    espToUpdate = esp
                    break
                end
            end
            
            if not hasESP and player.Character then
                CreateESP(player)
            elseif hasESP and espToUpdate then
                if not espToUpdate.Box or not espToUpdate.Box.Parent then
                    RemoveESP(player)
                    CreateESP(player)
                else
                    UpdateESPColor(player)
                end
            end
        end
    end
    
    for i = #espObjects, 1, -1 do
        local esp = espObjects[i]
        if not esp.Player or not esp.Player.Parent or not esp.Player.Character then
            if esp.Box then esp.Box:Destroy() end
            table.remove(espObjects, i)
        end
    end
end

-- Toggle ESP
local function ToggleESP()
    espEnabled = not espEnabled
    
    if espEnabled then
        for _, esp in pairs(espObjects) do
            if esp.Box then esp.Box:Destroy() end
        end
        espObjects = {}
        
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                CreateESP(player)
            end
        end
        
        espConnection = RunService.RenderStepped:Connect(function()
            if espEnabled then
                UpdateAllESP()
            end
        end)
        
        playerAddedConnection = Players.PlayerAdded:Connect(function(player)
            if espEnabled then
                task.wait(0.5)
                CreateESP(player)
            end
        end)
        
        playerRemovedConnection = Players.PlayerRemoved:Connect(function(player)
            if espEnabled then
                RemoveESP(player)
            end
        end)
        
        local function onCharacterAdded(player)
            if espEnabled then
                task.wait(0.5)
                RemoveESP(player)
                CreateESP(player)
            end
        end
        
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                player.CharacterAdded:Connect(function()
                    onCharacterAdded(player)
                end)
            end
        end
        
        characterAddedConnection = Players.PlayerAdded:Connect(function(player)
            player.CharacterAdded:Connect(function()
                onCharacterAdded(player)
            end)
        end)
        
        print("ESP Enabled - Murderer: 🔴 Red | Sheriff: 🔵 Blue | Innocent: 🟢 Green")
    else
        if espConnection then espConnection:Disconnect() end
        if playerAddedConnection then playerAddedConnection:Disconnect() end
        if playerRemovedConnection then playerRemovedConnection:Disconnect() end
        if characterAddedConnection then characterAddedConnection:Disconnect() end
        
        for _, esp in pairs(espObjects) do
            if esp.Box then esp.Box:Destroy() end
        end
        espObjects = {}
        print("ESP Disabled")
    end
end

-- IMPROVED SHOOTING FUNCTION WITH JUMP PREDICTION
local function GetMurderer()
    for _,v in pairs(Players:GetPlayers()) do
        if v ~= LocalPlayer then
            if v.Backpack:FindFirstChild("Knife") or (v.Character and v.Character:FindFirstChild("Knife")) then
                return v
            end
        end
    end
end

local function EquipGun()
    local gun = LocalPlayer.Backpack:FindFirstChild("Gun")
    if gun then
        LocalPlayer.Character.Humanoid:EquipTool(gun)
        return gun
    end
    return LocalPlayer.Character:FindFirstChild("Gun")
end

-- IMPROVED AIM PREDICTION
local function ShootMurderer()
    local murderer = GetMurderer()
    if not murderer or not murderer.Character then return end

    local targetHRP = murderer.Character:FindFirstChild("HumanoidRootPart")
    local myHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")

    if not targetHRP or not myHRP then return end

    local gun = EquipGun()
    if not gun then return end

    local shootRemote = gun:FindFirstChild("Shoot")
    if not shootRemote then return end

    -- Get current position and velocity
    local targetPos = targetHRP.Position
    local velocity = targetHRP.AssemblyLinearVelocity
    
    -- Get the humanoid to check if jumping
    local humanoid = murderer.Character:FindFirstChild("Humanoid")
    local isJumping = humanoid and humanoid:GetState() == Enum.HumanoidStateType.Jumping
    
    -- Calculate base prediction
    local predicted = targetPos + (velocity * prediction)
    
    -- IMPROVED VERTICAL PREDICTION FOR JUMPS
    if isJumping then
        -- If target is jumping, aim higher
        local jumpHeight = 3.5 -- How high to aim when jumping
        predicted = predicted + Vector3.new(0, jumpHeight, 0)
        
        -- Add extra vertical offset based on velocity
        local verticalVelocity = velocity.Y
        if verticalVelocity > 0 then
            -- Rising: aim higher
            predicted = predicted + Vector3.new(0, verticalVelocity * 0.15, 0)
        elseif verticalVelocity < 0 then
            -- Falling: aim slightly lower to track descent
            predicted = predicted + Vector3.new(0, verticalVelocity * 0.1, 0)
        end
    else
        -- Not jumping: use standard offset
        predicted = predicted + Vector3.new(0, verticalOffset, 0)
    end
    
    -- Add extra prediction for running targets
    local horizontalSpeed = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
    if horizontalSpeed > 10 then
        -- Target is running fast, add extra lead
        local leadMultiplier = 1.2
        predicted = predicted + (velocity * 0.05 * leadMultiplier)
    end
    
    -- IMPORTANT: Check if target is on the ground vs in air
    local humanoidRootPart = murderer.Character:FindFirstChild("HumanoidRootPart")
    if humanoidRootPart then
        local raycastParams = RaycastParams.new()
        raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
        raycastParams.FilterDescendantsInstances = {murderer.Character}
        
        local rayOrigin = humanoidRootPart.Position
        local rayDirection = Vector3.new(0, -5, 0)
        local rayResult = workspace:Raycast(rayOrigin, rayDirection, raycastParams)
        
        if rayResult then
            -- Target is on ground, adjust aim
            local groundDistance = (rayOrigin.Y - rayResult.Position.Y)
            if groundDistance < 1.5 then
                -- Standing on ground, normal aim
                predicted = predicted + Vector3.new(0, 0.8, 0)
            end
        else
            -- Target is in air (jumping or falling)
            predicted = predicted + Vector3.new(0, 1.5, 0)
        end
    end

    -- Fire the shot
    local args = {
        CFrame.new(myHRP.Position, predicted),
        CFrame.new(predicted)
    }
    shootRemote:FireServer(unpack(args))
end

